<div class="hi-values-wrap">
  <div class="hi-values">
    <div class="hi-values-set">
      {%- for block in section.blocks -%}
        <span class="hi-value-item" {{ block.shopify_attributes }}>
          <span class="hi-value-dot" aria-hidden="true"></span>
          <span class="hi-value-text">{{ block.settings.label }}</span>
        </span>
      {%- endfor -%}
    </div>
    <div class="hi-values-dup" aria-hidden="true">
      {%- for block in section.blocks -%}
        <span class="hi-value-item">
          <span class="hi-value-dot" aria-hidden="true"></span>
          <span class="hi-value-text">{{ block.settings.label }}</span>
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.hi-values-wrap {
  background: #16150F;
  overflow: hidden;
}
.hi-value-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-value-text {
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: .20em;
  text-transform: uppercase;
  color: #F3EFE6;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Values Strip",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Value",
          "placeholder": "e.g. Honor",
          "default": "Honor",
          "info": "Displayed in the scrolling strip. Keep it short — 1–3 words."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values Strip",
      "blocks": [
        { "type": "value", "settings": { "label": "Honor" } },
        { "type": "value", "settings": { "label": "Character" } },
        { "type": "value", "settings": { "label": "Integrity" } },
        { "type": "value", "settings": { "label": "Hard Work" } },
        { "type": "value", "settings": { "label": "Service" } },
        { "type": "value", "settings": { "label": "Legacy" } }
      ]
    }
  ]
}
{% endschema %}
