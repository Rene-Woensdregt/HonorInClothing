<section class="hi-ig-section">
  <div class="hi-ig-wrap">
    <div class="hi-ig-header" data-hi-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hi-ig-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hi-ig-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    {%- liquid
      assign has_any_image = false
      for block in section.blocks
        if block.settings.image != blank
          assign has_any_image = true
          break
        endif
      endfor
    -%}
    {%- if section.blocks.size > 0 and has_any_image -%}
      <div class="hi-ig-grid">
        {%- for block in section.blocks -%}
          {%- assign link = block.settings.url | default: section.settings.instagram_url -%}
          <a href="{{ link }}" class="hi-ig" target="_blank" rel="noopener" aria-label="{{ 'hi.instagram.name' | t }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: 'hi-ig-img', loading: 'lazy', alt: block.settings.image.alt | default: section.settings.title }}
            {%- else -%}
              <div class="hi-ig-placeholder"></div>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.instagram_url != blank or section.blocks.size > 0 -%}
      <div class="hi-ig-cta-wrap">
        <p class="hi-ig-cta-text">Share your journey — tag us to be featured here.</p>
        {%- assign ig_url = section.settings.instagram_url | default: 'https://instagram.com/honorinclothing' -%}
        <a href="{{ ig_url }}" class="hi-btn hi-btn--outline hi-ig-cta-btn" target="_blank" rel="noopener">
          Follow @honorinclothing
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-ig-section { padding: 80px 32px 70px; background: #FBF9F5; }
.hi-ig-wrap { max-width: 1280px; margin: 0 auto; }
.hi-ig-header { text-align: center; margin-bottom: 34px; }
.hi-ig-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 10px;
}
.hi-ig-title {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(26px, 3.2vw, 42px);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  color: #16150F;
  margin: 0 !important;
}
.hi-ig-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
.hi-ig {
  display: block;
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}
.hi-ig-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .9s cubic-bezier(.2,.7,.3,1);
}
.hi-ig:hover .hi-ig-img { transform: scale(1.07); }
.hi-ig-placeholder {
  position: absolute;
  inset: 0;
  background: #D3CCBE;
}
.hi-ig-cta-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  padding: 48px 0 16px;
}
.hi-ig-cta-text {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 17px;
  color: #6B675C;
  margin: 0;
  text-align: center;
}
.hi-ig-cta-btn {
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: 14px 32px;
  border: 1.5px solid #16150F !important;
  color: #16150F !important;
  text-decoration: none;
  transition: background .25s, color .25s;
}
.hi-ig-cta-btn:hover { background: #16150F !important; color: #FBF9F5 !important; }
@media (max-width: 900px) {
  .hi-ig-grid { grid-template-columns: repeat(3,1fr) !important; }
}
@media (max-width: 560px) {
  .hi-ig-section { padding: 56px 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "e.g. @honorinclothing",
      "default": "@honorinclothing",
      "info": "Small uppercase label above the heading — displayed in sage green. Use your Instagram handle."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "placeholder": "e.g. Follow The Journey",
      "default": "Follow The Journey",
      "info": "Displayed in large bold uppercase (Oswald)"
    },
    {
      "type": "header",
      "content": "Instagram link"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL",
      "info": "Default link for all photos — set to your Instagram profile page. Each photo block can override this with its own URL."
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square (1:1) recommended — 600×600px or larger"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL",
          "info": "Optional — links to a specific Instagram post. Leave blank to use the section Instagram URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
