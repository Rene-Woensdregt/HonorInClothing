<section class="hi-testi" data-hi-testimonials>
  <div class="hi-testi-inner">
    <div class="hi-testi-header" data-hi-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hi-testi-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hi-testi-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="hi-testi-track" data-track>
        {%- for block in section.blocks -%}
          <div class="hi-tcard" {{ block.shopify_attributes }}>
            <div class="hi-tcard-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="hi-tcard-star{% if i > block.settings.rating %} hi-tcard-star--empty{% endif %}" aria-hidden="true">★</span>
              {%- endfor -%}
            </div>
            {%- if block.settings.quote != blank -%}
              <blockquote class="hi-tcard-quote">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
            {%- endif -%}
            <div class="hi-tcard-meta">
              {%- if block.settings.author != blank -%}
                <span class="hi-tcard-author">{{ block.settings.author }}</span>
              {%- endif -%}
              {%- assign loc_line = '' -%}
              {%- if block.settings.subtitle != blank and block.settings.location != blank -%}
                {%- assign loc_line = block.settings.subtitle | append: ' · ' | append: block.settings.location -%}
              {%- elsif block.settings.subtitle != blank -%}
                {%- assign loc_line = block.settings.subtitle -%}
              {%- elsif block.settings.location != blank -%}
                {%- assign loc_line = block.settings.location -%}
              {%- endif -%}
              {%- if loc_line != '' -%}
                <span class="hi-tcard-loc">{{ loc_line }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="hi-testi-dots" role="tablist" aria-label="{{ 'hi.testimonials.name' | t }}">
          {%- for block in section.blocks -%}
            <button class="hi-dot" role="tab" aria-selected="false" aria-label="{{ 'hi.general.go_to_slide' | t | default: 'Go to slide' }} {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-testi {
  padding: 90px 32px;
  background: #FBF9F5;
}
.hi-testi-inner { max-width: 820px; margin: 0 auto; text-align: center; }
.hi-testi-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 12px;
}
.hi-testi-title {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(28px, 3.4vw, 44px);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  color: #16150F;
  margin: 0 0 48px !important;
}
.hi-testi-track {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.hi-testi-track::-webkit-scrollbar { display: none; }
.hi-tcard {
  flex: 0 0 100%;
  scroll-snap-align: center;
}
.hi-tcard-stars {
  display: flex;
  justify-content: center;
  gap: 4px;
  margin-bottom: 32px;
}
.hi-tcard-star {
  color: #C9A227;
  font-size: 18px;
}
.hi-tcard-star--empty { color: #D3CCBE; }
.hi-tcard-quote {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: clamp(18px, 1.7vw, 23px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.65;
  color: #16150F;
  margin: 0 0 28px;
  border: none !important;
  padding: 0 !important;
}
.hi-tcard-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}
.hi-tcard-author {
  font-family: 'Oswald', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #16150F;
}
.hi-tcard-loc {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 13.5px;
  color: #8A8479;
}
.hi-testi-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 42px;
}
@media (max-width: 560px) {
  .hi-testi { padding: 60px 20px 56px; }
}
{% endstylesheet %}

{% javascript %}
(function(){
  document.querySelectorAll('[data-hi-testimonials]').forEach(function(sec){
    var track=sec.querySelector('[data-track]');
    var dots=Array.from(sec.querySelectorAll('.hi-dot'));
    if(!track||!dots.length)return;
    var count=track.children.length;
    function go(i){track.scrollTo({left:i*track.clientWidth,behavior:'smooth'});}
    function updateDots(){
      var i=Math.round(track.scrollLeft/Math.max(1,track.clientWidth));
      dots.forEach(function(d,j){
        d.setAttribute('data-active',j===i?'true':'false');
        d.setAttribute('aria-selected',j===i?'true':'false');
      });
    }
    dots.forEach(function(d,i){d.addEventListener('click',function(){go(i);});});
    track.addEventListener('scroll',updateDots,{passive:true});
    if(dots[0])dots[0].setAttribute('data-active','true');
    var auto=null;
    function stop(){if(auto){clearInterval(auto);auto=null;}}
    function tick(){var cur=Math.round(track.scrollLeft/Math.max(1,track.clientWidth));go((cur+1)%count);}
    function start(){stop();auto=setInterval(tick,5000);}
    start();
    sec.addEventListener('mouseenter',stop);
    sec.addEventListener('mouseleave',start);
    track.addEventListener('pointerdown',stop);
    window.addEventListener('pointerup',function(){if(!auto)start();});
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "e.g. Worn With Purpose",
      "default": "Trusted By Many",
      "info": "Small uppercase label above the heading — displayed in sage green"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "placeholder": "e.g. What People Are Saying",
      "default": "What Our Community Says"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "placeholder": "e.g. Finally a brand that stands for something real.",
          "default": "This brand represents everything I believe in. The quality is outstanding and I wear it with pride every day."
