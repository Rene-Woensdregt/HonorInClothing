<section class="hi-ahero">
  <div class="hi-ahero-bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hi-ahero-img', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {%- else -%}
      <div class="hi-ahero-img-ph"></div>
    {%- endif -%}
  </div>
  <div class="hi-ahero-overlay"></div>
  <div class="hi-ahero-inner" data-hi-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <div class="hi-ahero-eyebrow">
        <span class="hi-ahero-rule" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hi-ahero-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="hi-ahero-body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-ahero {
  position: relative;
  height: 84vh;
  min-height: 580px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.hi-ahero-bg { position: absolute; inset: 0; }
.hi-ahero-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.hi-ahero-img-ph { width: 100%; height: 100%; background: #3A372F; }
.hi-ahero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(22,21,15,.3) 0%, rgba(22,21,15,.68) 100%);
}
.hi-ahero-inner {
  position: relative;
  z-index: 2;
  text-align: left;
  padding: 0 32px 80px;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
}
.hi-ahero-eyebrow {
  display: flex;
  align-items: center;
  gap: 18px;
  font-family: 'Oswald', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #9AA585;
  margin-bottom: 28px;
}
.hi-ahero-rule {
  display: inline-block;
  width: 40px;
  height: 1px;
  background: #9AA585;
  flex-shrink: 0;
}
.hi-ahero-h1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  font-size: clamp(44px, 6vw, 84px);
  text-transform: uppercase;
  letter-spacing: .02em;
  line-height: 1;
  color: #FBF9F5;
  margin: 0 0 28px;
  max-width: 8.8em;
}
.hi-ahero-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.72;
  color: rgba(251,249,245,.82);
  max-width: 54ch;
}
@media (max-width: 640px) {
  .hi-ahero { height: 72vh; min-height: 460px; }
  .hi-ahero-inner { padding: 0 24px 56px; }
  .hi-ahero-eyebrow { gap: 12px; }
  .hi-ahero-rule { width: 28px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_about_hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:hi.hi_about_hero.settings.image.label",
      "info": "Recommended: wide landscape image, 2400×1200px or larger."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_about_hero.settings.eyebrow.label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_about_hero.settings.heading.label",
      "default": "Honor in everything we do."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:hi.hi_about_hero.settings.body.label",
      "default": "We build premium active-lifestyle apparel for people who live with purpose — and we do it in a way we can be proud of, on the trail, on the job, and in the communities we serve."
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_about_hero.name"
    }
  ]
}
{% endschema %}
