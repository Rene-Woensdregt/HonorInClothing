<section class="hi-ahero">
  <div class="hi-ahero-bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hi-ahero-img', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {%- else -%}
      <div class="hi-ahero-img-ph"></div>
    {%- endif -%}
  </div>
  <div class="hi-ahero-overlay"></div>
  <div class="hi-ahero-inner" data-hi-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <div class="hi-ahero-eyebrow">
        <span class="hi-ahero-rule" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hi-ahero-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="hi-ahero-body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
  <a href="#our-commitment" class="hi-ahero-scroll-btn" aria-label="Scroll to Our Commitment">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M10 3v14M10 17l-5-5M10 17l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

{% stylesheet %}
.hi-ahero {
  position: relative;
  height: 84vh;
  min-height: 580px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.hi-ahero-bg { position: absolute; inset: 0; }
.hi-ahero-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.hi-ahero-img-ph { width: 100%; height: 100%; background: #3A372F; }
.hi-ahero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(22,21,15,.3) 0%, rgba(22,21,15,.68) 100%);
}
.hi-ahero-inner {
  position: relative;
  z-index: 2;
  text-align: left;
  padding: 0 32px 80px;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
}
.hi-ahero-eyebrow {
  display: flex;
  align-items: center;
  gap: 18px;
  font-family: 'Oswald', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #9AA585;
  margin-bottom: 28px;
}
.hi-ahero-rule {
  display: inline-block;
  width: 40px;
  height: 1px;
  background: #9AA585;
  flex-shrink: 0;
}
.hi-ahero-h1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  font-size: clamp(44px, 6vw, 84px);
  text-transform: uppercase;
  letter-spacing: .02em;
  line-height: 1;
  color: #FBF9F5;
  margin: 0 0 28px;
  max-width: 8.8em;
}
.hi-ahero-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.72;
  color: rgba(251,249,245,.82);
  max-width: 54ch;
}
.hi-ahero-scroll-btn {
  position: absolute;
  right: 48px;
  bottom: 72px;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 1px solid rgba(251,249,245,.45);
  background: rgba(251,249,245,.08);
  color: #FBF9F5;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: background .3s, border-color .3s, transform .3s cubic-bezier(.2,.7,.3,1);
  z-index: 3;
  backdrop-filter: blur(6px);
  animation: hi-scroll-pulse 2.8s ease-in-out infinite;
}
.hi-ahero-scroll-btn:hover {
  background: rgba(251,249,245,.2);
  border-color: rgba(251,249,245,.85);
  transform: translateY(4px);
  animation: none;
}
@keyframes hi-scroll-pulse {
  0%, 100% { transform: translateY(0); opacity: .85; }
  50% { transform: translateY(5px); opacity: 1; }
}
@media (max-width: 640px) {
  .hi-ahero { height: 95vh; min-height: 580px; }
  .hi-ahero-inner { padding: 0 24px 110px; }
  .hi-ahero-eyebrow { gap: 12px; }
  .hi-ahero-rule { width: 28px; }
  .hi-ahero-scroll-btn {
    right: auto;
    left: 50%;
    transform: translateX(-50%);
    bottom: 28px;
    width: 56px;
    height: 56px;
    animation: hi-scroll-pulse-mobile 2.8s ease-in-out infinite;
  }
}
@keyframes hi-scroll-pulse-mobile {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: .85; }
  50% { transform: translateX(-50%) translateY(5px); opacity: 1; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_about_hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:hi.hi_about_hero.settings.image.label",
      "info": "Recommended: wide landscape image, 2400×1200px or larger."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_about_hero.settings.eyebrow.label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_about_hero.settings.heading.label",
      "default": "Honor in everything we do."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:hi.hi_about_hero.settings.body.label",
      "default": "We build premium active-lifestyle apparel for people who live with purpose — and we do it in a way we can be proud of, on the trail, on the job, and in the communities we serve."
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_about_hero.name"
    }
  ]
}
{% endschema %}
