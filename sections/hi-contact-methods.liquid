<section class="hi-cmethods">
  <div class="hi-cmethods-inner">
    <div class="hi-cmethods-grid">
      {%- for block in section.blocks -%}
        <div class="hi-cmethod" {{ block.shopify_attributes }}>
          <div class="hi-cmethod-ic" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'email' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="M2 7l10 6 10-6"/>
                </svg>
              {%- when 'phone' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15.5a2 2 0 0 1-2.2 2 19 19 0 0 1-8.3-3 18.5 18.5 0 0 1-5.7-5.7 19 19 0 0 1-3-8.4A2 2 0 0 1 3.8 0h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 7.6a15 15 0 0 0 5.7 5.7l1-1a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
                </svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-4-.9L3 21l2-4a8.4 8.4 0 0 1-1-4 8.5 8.5 0 0 1 17 0z"/>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <div class="hi-cmethod-title">{{ block.settings.title }}</div>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="hi-cmethod-body">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link_url }}" class="hi-cmethod-link">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.hi-cmethods { background: #FBF9F5; }
.hi-cmethods-inner { max-width: 1280px; margin: 0 auto; padding: 70px 32px 20px; }
.hi-cmethods-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.hi-cmethod {
  background: #fff;
  border: 1px solid #E7E2D7;
  padding: 30px 28px;
  transition: border-color .3s ease, transform .3s ease;
}
.hi-cmethod:hover {
  border-color: #16150F;
  transform: translateY(-4px);
}
.hi-cmethod-ic {
  width: 26px;
  height: 26px;
  color: #5C6B47;
  margin-bottom: 16px;
  display: block;
}
.hi-cmethod-ic svg { width: 26px; height: 26px; display: block; }
.hi-cmethod-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 16px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #16150F;
  margin-bottom: 8px;
}
.hi-cmethod-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 14.5px;
  line-height: 1.6;
  color: #54504A;
  margin-bottom: 12px;
}
.hi-cmethod-link {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #16150F;
  text-decoration: none;
  border-bottom: 2px solid #5C6B47;
  padding-bottom: 3px;
  display: inline-block;
}
@media (max-width: 900px) {
  .hi-cmethods-inner { padding: 56px 24px 16px; }
  .hi-cmethods-grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_contact_methods.name",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "method",
      "name": "t:hi.hi_contact_methods.blocks.method.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:hi.hi_contact_methods.blocks.method.settings.icon.label",
          "options": [
            { "value": "email", "label": "t:hi.hi_contact_methods.blocks.method.settings.icon.options__1.label" },
            { "value": "phone", "label": "t:hi.hi_contact_methods.blocks.method.settings.icon.options__2.label" },
            { "value": "chat",  "label": "t:hi.hi_contact_methods.blocks.method.settings.icon.options__3.label" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:hi.hi_contact_methods.blocks.method.settings.title.label",
          "default": "Email Us"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:hi.hi_contact_methods.blocks.method.settings.body.label",
          "default": "For orders, sizing, and general questions. We reply within one business day."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:hi.hi_contact_methods.blocks.method.settings.link_label.label",
          "default": "help@honorinclothing.com"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:hi.hi_contact_methods.blocks.method.settings.link_url.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_contact_methods.name",
      "blocks": [
        {
          "type": "method",
          "settings": {
            "icon": "email",
            "title": "Email Us",
            "body": "For orders, sizing, and general questions. We reply within one business day.",
            "link_label": "help@honorinclothing.com"
          }
        },
        {
          "type": "method",
          "settings": {
            "icon": "phone",
            "title": "Call Us",
            "body": "Prefer to talk it through? Our team is on the line during support hours.",
            "link_label": "1-800-555-1234"
          }
        },
        {
          "type": "method",
          "settings": {
            "icon": "chat",
            "title": "Live Chat",
            "body": "Chat with a real person for quick answers while you shop the store.",
            "link_label": "Start a chat →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
