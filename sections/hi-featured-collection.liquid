<section class="hi-fcol" data-hi-carousel>
  <div class="hi-fcol-inner">
    <div class="hi-fcol-header" data-hi-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="hi-fcol-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="hi-fcol-title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="hi-fcol-showall">
          {{ section.settings.view_all_label }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
    <div class="hi-carousel-wrap">
      <button class="hi-arrow hi-arrow--left" data-prev aria-label="{{ 'hi.general.prev' | t | default: 'Previous' }}">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="hi-track" data-track>
        {%- assign col = section.settings.collection -%}
        {%- if col != blank -%}
          {%- for product in col.products limit: section.settings.products_limit -%}
            <a href="{{ product.url }}" class="hi-card hi-fcol-card" aria-label="{{ product.title }}">
              <div class="hi-card-img-wrap">
                <div class="hi-card-img-inner">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 600 | image_tag: class: 'hi-card-img-el', loading: 'lazy', alt: product.title }}
                  {%- else -%}
                    <div class="hi-card-img-placeholder"></div>
                  {%- endif -%}
                  {%- if section.settings.badge_label != blank -%}
                    <div class="hi-card-badge{% if section.settings.badge_style == 'accent' %} hi-card-badge--accent{% endif %}">{{ section.settings.badge_label }}</div>
                  {%- elsif product.available == false -%}
                    <div class="hi-card-badge">{{ 'hi.featured_collection.sold_out' | t }}</div>
                  {%- endif -%}
                </div>
              </div>
              <div class="hi-card-body">
                {%- if product.type != blank -%}
                  <div class="hi-card-category">{{ product.type }}</div>
                {%- endif -%}
                <div class="hi-card-name">{{ product.title }}</div>
                {%- if section.settings.show_price -%}
                  <div class="hi-card-price">{{ product.price | money }}</div>
                {%- endif -%}
              </div>
            </a>
          {%- else -%}
            {%- for i in (1..4) -%}
              <a href="#" class="hi-card hi-fcol-card" aria-hidden="true">
                <div class="hi-card-img-wrap">
                  <div class="hi-card-img-inner hi-card-img-placeholder"></div>
                </div>
                <div class="hi-card-body">
                  <div class="hi-card-name">Sample Product</div>
                  <div class="hi-card-price">$0.00</div>
                </div>
              </a>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <a href="#" class="hi-card hi-fcol-card" aria-hidden="true">
              <div class="hi-card-img-wrap">
                <div class="hi-card-img-inner hi-card-img-placeholder"></div>
              </div>
              <div class="hi-card-body">
                <div class="hi-card-name">Sample Product</div>
                <div class="hi-card-price">$0.00</div>
              </div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="hi-arrow hi-arrow--right" data-next aria-label="{{ 'hi.general.next' | t | default: 'Next' }}">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
.hi-fcol { padding: 88px 32px 70px; }
.hi-fcol-inner { max-width: 1280px; margin: 0 auto; }
.hi-fcol-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 40px;
}
.hi-fcol-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 12px;
}
.hi-fcol-title {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(28px, 3vw, 46px);
  font-weight: 600;
  letter-spacing: .01em;
  text-transform: uppercase;
  color: #16150F;
  margin: 0;
}
.hi-fcol-showall {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #16150F;
  text-decoration: none;
  border-bottom: 2px solid #5C6B47;
  padding-bottom: 5px;
  transition: color .25s, border-color .25s;
  white-space: nowrap;
}
.hi-fcol-showall:hover { color: #5C6B47; border-color: #5C6B47; }
.hi-carousel-wrap { position: relative; }
.hi-fcol-card {
  flex: 0 0 calc((100% - 60px) / 4);
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
}
.hi-card-img-wrap {
  display: block;
  aspect-ratio: 3 / 4;
  position: relative;
  overflow: hidden;
  background: #E9E4DA;
}
.hi-card-img-inner {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.hi-card-img-el {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .9s cubic-bezier(.2,.7,.3,1);
}
.hi-card:hover .hi-card-img-el { transform: scale(1.07); }
.hi-card-img-placeholder {
  width: 100%;
  height: 100%;
  background: #E9E4DA;
}
.hi-card-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #FBF9F5;
  color: #16150F;
  font-family: 'Oswald', sans-serif;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 5px 10px;
}
.hi-card-badge--accent {
  background: #5C6B47;
  color: #fff;
}
.hi-card-body { padding: 18px 16px 20px; display: flex; flex-direction: column; flex: 1; }
.hi-card-category {
  font-family: 'Oswald', sans-serif;
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 0;
}
.hi-card-name {
  display: block;
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 16px;
  font-weight: 600;
  color: #16150F;
  margin-top: 5px;
  transition: color .2s;
}
.hi-card-price {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 15px;
  font-weight: 400;
  color: #6B675C;
  margin-top: auto;
  padding-top: 4px;
}
@media (max-width: 900px) {
  .hi-fcol { padding: 60px 20px 48px; }
  .hi-fcol-card { flex: 0 0 calc((100% - 24px) / 2.1) !important; }
}
@media (max-width: 560px) {
  .hi-fcol-card { flex: 0 0 80% !important; }
  .hi-fcol-header { flex-direction: column; align-items: flex-start; gap: 14px; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('[data-hi-carousel]').forEach(function(sec){
  var track=sec.querySelector('[data-track]');
  var prev=sec.querySelector('[data-prev]');
  var next=sec.querySelector('[data-next]');
  if(!track||!prev||!next)return;
  var card=track.querySelector('.hi-card');
  function scrollBy(dir){var w=card?card.offsetWidth+20:280;track.scrollBy({left:dir*w*2,behavior:'smooth'});}
  prev.addEventListener('click',function(){scrollBy(-1);});
  next.addEventListener('click',function(){scrollBy(1);});
});
{% endjavascript %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "e.g. Just Dropped",
      "default": "Just Dropped",
      "info": "Small label above the heading — displayed in sage green"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "placeholder": "e.g. New Arrivals",
      "default": "New Arrivals"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "info": "Products scroll horizontally — all are visible via the carousel"
    },
    {
      "type": "header",
      "content": "\"View all\" link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "placeholder": "e.g. Shop All New",
      "default": "Shop All New"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link URL",
      "info": "Leave blank to hide the link"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "placeholder": "e.g. NEW, SALE, BEST SELLER",
      "info": "Appears on every card in this section. Leave blank for no badge."
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge color",
      "options": [
        { "value": "light", "label": "Light — linen background, dark text" },
        { "value": "accent", "label": "Sage — green background, white text" }
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
