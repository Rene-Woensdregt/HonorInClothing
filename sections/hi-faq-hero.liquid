<section class="hi-faqhero">
  <div class="hi-faqhero-bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hi-faqhero-img', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {%- else -%}
      <div class="hi-faqhero-img-ph"></div>
    {%- endif -%}
  </div>
  <div class="hi-faqhero-overlay"></div>
  <div class="hi-faqhero-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hi-faqhero-eyebrow">
        <span class="hi-faqhero-rule" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hi-faqhero-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="hi-faqhero-body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-faqhero {
  position: relative;
  min-height: 300px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hi-faqhero-bg { position: absolute; inset: 0; }
.hi-faqhero-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hi-faqhero-img-ph { width: 100%; height: 100%; background: #3A372F url(https://cdn.shopify.com/s/files/1/0910/9035/4474/files/theme_cover_image.jpg) center 25% / cover no-repeat; }
.hi-faqhero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12,12,9,.36) 0%, rgba(12,12,9,.22) 40%, rgba(12,12,9,.82) 100%);
}
.hi-faqhero-inner {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 0 32px 48px;
  color: #fff;
  text-shadow: 0 2px 22px rgba(10,11,8,.42);
}
.hi-faqhero-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #E9E3D4;
  margin-bottom: 16px;
}
.hi-faqhero-rule {
  display: inline-block;
  width: 34px;
  height: 1px;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-faqhero-h1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  font-size: clamp(38px, 5.4vw, 68px);
  line-height: .98;
  letter-spacing: .005em;
  color: #FBF9F5;
  margin: 0;
}
.hi-faqhero-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 17px;
  line-height: 1.6;
  color: rgba(247,243,234,.9);
  max-width: 54ch;
  margin: 16px 0 0;
}
@media (max-width: 640px) {
  .hi-faqhero { min-height: 240px; }
  .hi-faqhero-inner { padding: 0 24px 36px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_faq_hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:hi.hi_faq_hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_faq_hero.settings.eyebrow.label",
      "default": "Help Center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_faq_hero.settings.heading.label",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:hi.hi_faq_hero.settings.body.label",
      "default": "Answers on orders, shipping, sizing, returns, and our mission. Can't find what you need? We're one message away."
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_faq_hero.name"
    }
  ]
}
{% endschema %}
