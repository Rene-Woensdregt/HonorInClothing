<section class="hi-vet">
  {%- if section.settings.image != blank -%}
    <div class="hi-vet-bg" aria-hidden="true">
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'hi-vet-bg-img', loading: 'lazy', alt: section.settings.heading }}
    </div>
  {%- else -%}
    <div class="hi-vet-bg hi-vet-bg--placeholder" aria-hidden="true"></div>
  {%- endif -%}
  <div class="hi-vet-overlay" aria-hidden="true"></div>
  <div class="hi-vet-inner">
    <div class="hi-vet-content" data-hi-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hi-vet-eyebrow">
          <span class="hi-vet-eyebrow-line" aria-hidden="true"></span>
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hi-vet-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="hi-vet-body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="hi-btn hi-btn--accent hi-vet-cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.hi-vet {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.hi-vet-bg {
  position: absolute;
  inset: 0;
}
.hi-vet-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hi-vet-bg--placeholder {
  background: #2C3024;
}
.hi-vet-overlay {
  display: block !important;
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(20,22,16,.92) 0%, rgba(20,22,16,.72) 50%, rgba(20,22,16,.40) 100%);
}
.hi-vet-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 96px 32px;
}
.hi-vet-content {
  max-width: 620px;
  color: #F3EFE6;
}
.hi-vet-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .26em;
  text-transform: uppercase;
  color: #C9D2B6;
  margin-bottom: 20px;
}
.hi-vet-eyebrow-line {
  display: inline-block;
  width: 34px;
  height: 1px;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-vet-heading {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(28px, 3.05vw, 48px);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  line-height: 1.05;
  color: #F3EFE6;
  margin: 0 0 22px;
}
.hi-vet-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 19px;
  font-weight: 400;
  line-height: 1.7;
  color: rgba(243,239,230,.90);
  margin-bottom: 32px;
}
.hi-vet-cta { margin-top: 0; }
@media (max-width: 900px) {
  .hi-vet-inner { padding: 72px 24px; }
  .hi-vet-content { max-width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veteran Support",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Commitment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We honor those who served."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>After our first full year in business, Honor In Clothing plans to donate 10% of annual profits to a carefully selected organization supporting veterans living with PTSD.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Veteran Support"
    }
  ]
}
{% endschema %}
