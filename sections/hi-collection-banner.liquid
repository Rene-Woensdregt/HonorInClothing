{%- liquid
  assign banner_image = section.settings.image | default: collection.image
-%}

<section class="hi-colbanner">
  {%- if banner_image -%}
    {{ banner_image | image_url: width: 2000 | image_tag:
       loading: 'eager',
       fetchpriority: 'high',
       class: 'hi-colbanner-bg',
       alt: collection.title }}
  {%- endif -%}
  <div class="hi-colbanner-overlay" aria-hidden="true"></div>
  <div class="hi-colbanner-inner hi-x">
    <nav class="hi-colbanner-crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>
    <h1 class="hi-colbanner-title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <p class="hi-colbanner-desc">{{ collection.description | strip_html | truncatewords: 40 }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-colbanner {
  position: relative;
  height: 300px;
  overflow: hidden;
  background: #22211A;
}
.hi-colbanner-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 32%;
  display: block;
}
.hi-colbanner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12,12,9,.34) 0%, rgba(12,12,9,.66) 100%);
}
.hi-colbanner-inner {
  position: relative;
  height: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #fff;
  text-shadow: 0 2px 20px rgba(10,11,8,.4);
}
.hi-colbanner-crumb {
  font-family: 'Oswald', sans-serif;
  font-size: 12.5px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: #E2DCCE;
  margin-bottom: 14px;
}
.hi-colbanner-crumb a {
  color: inherit;
  text-decoration: none;
  opacity: .75;
  transition: opacity .2s;
}
.hi-colbanner-crumb a:hover { opacity: 1; }
.hi-colbanner-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  font-size: clamp(34px, 5vw, 56px);
  line-height: 1;
  letter-spacing: .01em;
  margin: 0;
  color: #fff;
}
.hi-colbanner-desc {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: rgba(247,243,234,.9);
  max-width: 52ch;
  margin: 16px 0 0;
}
@media (max-width: 640px) {
  .hi-colbanner { height: auto; min-height: 210px; }
  .hi-colbanner-inner { padding: 34px 20px; }
  .hi-colbanner-desc { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used when the collection has no image. Recommended: 2000×600px."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
