<section class="hi-chero">
  <div class="hi-chero-bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hi-chero-img', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {%- else -%}
      <div class="hi-chero-img-ph"></div>
    {%- endif -%}
  </div>
  <div class="hi-chero-overlay"></div>
  <div class="hi-chero-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hi-chero-eyebrow">
        <span class="hi-chero-rule" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hi-chero-h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="hi-chero-body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-chero {
  position: relative;
  min-height: 340px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hi-chero-bg { position: absolute; inset: 0; }
.hi-chero-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hi-chero-img-ph { width: 100%; height: 100%; background: #3A372F; }
.hi-chero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12,12,9,.34) 0%, rgba(12,12,9,.20) 40%, rgba(12,12,9,.82) 100%);
}
.hi-chero-inner {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 0 32px 52px;
  color: #fff;
  text-shadow: 0 2px 22px rgba(10,11,8,.42);
}
.hi-chero-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #E9E3D4;
  margin-bottom: 18px;
}
.hi-chero-rule {
  display: inline-block;
  width: 34px;
  height: 1px;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-chero-h1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  font-size: clamp(38px, 5.6vw, 72px);
  line-height: .98;
  letter-spacing: .005em;
  color: #FBF9F5;
  margin: 0;
}
.hi-chero-body {
  font-size: 17px;
  line-height: 1.6;
  color: rgba(247,243,234,.9);
  max-width: 52ch;
  margin: 16px 0 0;
  font-family: 'Hanken Grotesk', sans-serif;
}
@media (max-width: 640px) {
  .hi-chero { min-height: 280px; }
  .hi-chero-inner { padding: 0 24px 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_contact_hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:hi.hi_contact_hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_contact_hero.settings.eyebrow.label",
      "default": "We're Here To Help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_contact_hero.settings.heading.label",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:hi.hi_contact_hero.settings.body.label",
      "default": "Questions about sizing, an order, or our mission? Real people, honest answers — we usually reply within one business day."
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_contact_hero.name"
    }
  ]
}
{% endschema %}
