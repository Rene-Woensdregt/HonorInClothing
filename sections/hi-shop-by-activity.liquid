<section class="hi-act-section">
  <div class="hi-act-wrap">
    <div class="hi-act-header" data-hi-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hi-act-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="hi-act-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="hi-act-grid" style="--hi-act-cols:{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url }}" class="hi-tile hi-act-tile" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'hi-card-img', loading: 'lazy', alt: block.settings.label }}
            {%- else -%}
              <div class="hi-act-placeholder"></div>
            {%- endif -%}
            <div class="hi-act-tile-overlay" aria-hidden="true"></div>
            <div class="hi-act-tile-text">
              {%- if block.settings.sublabel != blank -%}
                <div class="hi-act-tile-sublabel">{{ block.settings.sublabel }}</div>
              {%- endif -%}
              <div class="hi-act-tile-main">
                <span class="hi-act-tile-label">{{ block.settings.label }}</span>
                <span class="hi-tile-arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.hi-act-section { padding: 80px 32px; background: #FBF9F5; }
.hi-act-wrap { max-width: 1280px; margin: 0 auto; }
.hi-act-header { text-align: center; margin-bottom: 40px; }
.hi-act-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 12px;
}
.hi-act-title {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(28px, 3vw, 46px);
  font-weight: 600;
  letter-spacing: .01em;
  text-transform: uppercase;
  color: #16150F;
  margin: 0;
}
.hi-act-grid { grid-template-columns: repeat(var(--hi-act-cols, 3), 1fr); }
.hi-act-tile {
  display: block;
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  text-decoration: none;
}
.hi-card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .9s cubic-bezier(.2,.7,.3,1);
}
.hi-act-tile:hover .hi-card-img { transform: scale(1.07); }
.hi-act-placeholder {
  position: absolute;
  inset: 0;
  background: #C5BFB5;
}
.hi-act-tile-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(12,12,9,0) 40%, rgba(12,12,9,.72) 100%);
  transition: opacity .3s;
}
.hi-act-tile:hover .hi-act-tile-overlay { opacity: .85; }
.hi-act-tile-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: block;
  padding: 30px 28px;
  z-index: 2;
}
.hi-act-tile-sublabel {
  font-family: 'Oswald', sans-serif;
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: #E2DCCE;
  margin-bottom: 4px;
}
.hi-act-tile-main {
  display: flex;
  align-items: center;
  gap: 12px;
}
.hi-act-tile-label {
  font-family: 'Oswald', sans-serif;
  font-size: 27px;
  font-weight: 600;
  letter-spacing: .02em;
  text-transform: uppercase;
  color: #fff;
}
.hi-tile-arrow {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
}
@media (max-width: 900px) {
  .hi-act-section { padding: 56px 20px; }
  .hi-act-grid { grid-template-columns: 1fr !important; }
  .hi-act-tile { aspect-ratio: 16 / 9; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Activity",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "e.g. Find Your Fit",
      "default": "Find Your Fit",
      "info": "Small uppercase label above the heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "placeholder": "e.g. Shop By Activity",
      "default": "Shop By Activity"
    }
  ],
  "blocks": [
    {
      "type": "activity",
      "name": "Activity tile",
      "settings": [
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label",
          "placeholder": "e.g. Hiking & Outdoors",
          "info": "Small uppercase label above the tile title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "placeholder": "e.g. On The Trail"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Portrait ratio (4:5) works best"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Activity",
      "blocks": [
        { "type": "activity", "settings": { "sublabel": "Hiking & Outdoors", "label": "On The Trail" } },
        { "type": "activity", "settings": { "sublabel": "Fitness & Performance", "label": "In Training" } },
        { "type": "activity", "settings": { "sublabel": "Work & Life", "label": "Everyday Carry" } }
      ]
    }
  ]
}
{% endschema %}
