<hi-product-related
  class="hi-related-section"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">

  {%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="hi-x hi-related-inner">
    <div class="hi-related-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="hi-related-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hi-related-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank and section.settings.view_all_url != blank -%}
        <a href="{{ section.settings.view_all_url }}" class="hi-related-viewall">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <div class="hi-related-grid">
      {%- for related in recommendations.products -%}
        {%- assign rel_badge = nil -%}
        {%- for tag in related.tags -%}
          {%- if tag == 'New' or tag == 'Best Seller' or tag == 'Sale' -%}
            {%- assign rel_badge = tag -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="hi-card">
          <a href="{{ related.url }}" style="display:block;text-decoration:none;color:inherit;">
            <div class="hi-card-media">
              {%- if related.featured_image -%}
                {{ related.featured_image | image_url: width: 600 | image_tag: class: 'hi-related-img', loading: 'lazy', alt: related.title }}
              {%- endif -%}
              {%- if rel_badge != blank -%}
                <span class="hi-card-badge">{{ rel_badge }}</span>
              {%- endif -%}
            </div>
            <div class="hi-card-body hi-card-body--related">
              {%- if related.type != blank -%}
                <div class="hi-card-cat">{{ related.type }}</div>
              {%- endif -%}
              <div class="hi-card-name">{{ related.title }}</div>
              <div class="hi-card-price-row">
                <span class="hi-card-price">{{ related.price | money }}</span>
                {%- if related.compare_at_price > related.price -%}
                  <span class="hi-card-price-compare">{{ related.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

</hi-product-related>

{% javascript %}
if (!customElements.get('hi-product-related')) {
  customElements.define('hi-product-related', class extends HTMLElement {
    connectedCallback() {
      var url = this.dataset.url;
      if (!url) return;
      fetch(url)
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var el = doc.querySelector('hi-product-related');
          if (el && el.innerHTML.trim()) {
            document.querySelector('hi-product-related[data-url="' + url + '"]').innerHTML = el.innerHTML;
          }
        });
    }
  });
}
{% endjavascript %}

{% stylesheet %}
.hi-related-section { background: #F1ECE1; }
.hi-related-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 80px 32px;
}
.hi-related-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 38px;
}
.hi-related-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 12px;
}
.hi-related-heading {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: clamp(28px, 3.4vw, 42px);
  line-height: 1;
  margin: 0;
  color: #16150F;
}
.hi-related-viewall {
  text-decoration: none;
  color: #16150F;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  border-bottom: 2px solid #5C6B47;
  padding-bottom: 5px;
  white-space: nowrap;
  transition: color .2s ease;
}
.hi-related-viewall:hover { color: #5C6B47; }
.hi-related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.hi-card-media {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #E9E4DA;
}
.hi-related-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .5s cubic-bezier(.2,.7,.3,1);
}
.hi-related-section .hi-card:hover .hi-related-img {
  transform: scale(1.04);
}
.hi-card-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #5C6B47;
  color: #fff;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 10.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 5px 10px;
  z-index: 2;
}
.hi-card-body--related { padding: 14px 4px 4px; }
.hi-card-price-row { margin-top: 6px; }
.hi-card-price { font-size: 15px; color: #16150F; font-weight: 600; }
.hi-card-price-compare { font-size: 13px; color: #A39E92; text-decoration: line-through; margin-left: 6px; }
@media (max-width: 900px) {
  .hi-related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .hi-related-inner { padding: 60px 20px; }
  .hi-related-grid { gap: 14px 12px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_product_related.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_product_related.settings.eyebrow.label",
      "default": "Complete The Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_product_related.settings.heading.label",
      "default": "You May Also Like"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:hi.hi_product_related.settings.view_all_label.label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "t:hi.hi_product_related.settings.view_all_url.label"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "t:hi.hi_product_related.settings.fallback_collection.label"
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_product_related.name"
    }
  ]
}
{% endschema %}
