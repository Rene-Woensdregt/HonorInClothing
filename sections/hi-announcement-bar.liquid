<div class="hi-ann-bar">
  <div class="hi-ann-track" style="--hi-ann-speed: {{ section.settings.speed }}s">
    {%- assign repeat = '12345678' | split: '' -%}
    {%- for i in repeat -%}
      <span class="hi-ann-item">{{ section.settings.text }}</span>
      <span class="hi-ann-bullet" aria-hidden="true">✦</span>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.hi-ann-bar {
  height: 40px;
  background: #16150F;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.hi-ann-track {
  display: flex;
  align-items: center;
  white-space: nowrap;
  width: max-content;
  animation: hi-marquee var(--hi-ann-speed, 40s) linear infinite;
}
.hi-ann-item {
  font-family: 'Oswald', sans-serif;
  font-size: 12.5px;
  font-weight: 400;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #FBF9F5;
  padding: 0 22px;
}
.hi-ann-bullet {
  color: #5C6B47;
  font-size: 10px;
  flex-shrink: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Complimentary shipping on orders over $75"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
