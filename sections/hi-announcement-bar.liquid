{%- if section.blocks.size > 0 -%}
<div class="hi-ann-bar" role="region" aria-label="{{ 'hi.announcement_bar.label' | t }}">
  <div class="hi-ann-track" style="--hi-ann-speed:{{ section.settings.speed }}s">
    {%- comment -%}Set A — visible{%- endcomment -%}
    {%- for block in section.blocks -%}
      <span class="hi-ann-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      <span class="hi-ann-sep" aria-hidden="true">✦</span>
    {%- endfor -%}
    {%- comment -%}Set B — duplicate for seamless loop{%- endcomment -%}
    {%- for block in section.blocks -%}
      <span class="hi-ann-item" aria-hidden="true">{{ block.settings.text }}</span>
      <span class="hi-ann-sep" aria-hidden="true">✦</span>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
.hi-ann-bar {
  background: #16150F;
  color: #F3EFE6;
  overflow: hidden;
  height: 40px;
  display: flex;
  align-items: center;
}

@keyframes hi-ann-marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.hi-ann-track {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
  animation: hi-ann-marquee var(--hi-ann-speed, 40s) linear infinite;
}

.hi-ann-track:hover { animation-play-state: paused; }

.hi-ann-item {
  font-family: 'Oswald', sans-serif;
  font-size: 12.5px;
  letter-spacing: .16em;
  text-transform: uppercase;
  padding: 0 22px;
  line-height: 1;
}

.hi-ann-sep {
  color: #5C6B47;
  font-size: 10px;
  flex-shrink: 0;
  line-height: 1;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.announcement_bar.name",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:hi.announcement_bar.settings.speed.label",
      "min": 15,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:hi.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:hi.announcement_bar.blocks.message.settings.text.label",
          "default": "Complimentary shipping on orders over $75"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:hi.announcement_bar.name",
      "blocks": [
        { "type": "message", "settings": { "text": "Complimentary shipping on orders over $75" } },
        { "type": "message", "settings": { "text": "Honor in everything you do." } },
        { "type": "message", "settings": { "text": "Free returns on all orders" } }
      ]
    }
  ]
}
{% endschema %}
