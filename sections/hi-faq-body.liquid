{%- assign faq_cat_ids = 'orders,shipping,returns,sizing,mission' | split: ',' -%}
{%- assign faq_cat_labels = 'Orders & Payment,Shipping & Delivery,Returns & Exchanges,Sizing & Fit,Product & Our Mission' | split: ',' -%}

<section class="hi-faqbody">
  <div class="hi-faqbody-inner">
    <div class="hi-faqlayout">

      <!-- Category sidebar nav -->
      <nav class="hi-catnav" aria-label="{{ 'hi.hi_faq_body.nav_label' | t }}">
        {%- for cat_id in faq_cat_ids -%}
          {%- assign cat_label = faq_cat_labels[forloop.index0] -%}
          <button
            class="hi-catlink"
            type="button"
            data-cat-btn
            data-target="faq-{{ cat_id }}"
            {%- if forloop.first %} data-on="true"{% endif %}
          >{{ cat_label }}</button>
        {%- endfor -%}
      </nav>

      <!-- FAQ groups + CTA -->
      <div>
        {%- for cat_id in faq_cat_ids -%}
          {%- assign cat_index = forloop.index0 -%}
          {%- assign cat_label = faq_cat_labels[cat_index] -%}
          {%- case cat_id -%}
            {%- when 'orders' -%}{%- assign cat_sub = section.settings.orders_subtitle -%}
            {%- when 'shipping' -%}{%- assign cat_sub = section.settings.shipping_subtitle -%}
            {%- when 'returns' -%}{%- assign cat_sub = section.settings.returns_subtitle -%}
            {%- when 'sizing' -%}{%- assign cat_sub = section.settings.sizing_subtitle -%}
            {%- when 'mission' -%}{%- assign cat_sub = section.settings.mission_subtitle -%}
          {%- endcase -%}
          {%- assign has_items = false -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.category == cat_id -%}
              {%- assign has_items = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if has_items -%}
            <div class="hi-faqgroup" id="faq-{{ cat_id }}" data-faq-group>
              <div class="hi-faqgroup-title">{{ cat_label }}</div>
              {%- if cat_sub != blank -%}
                <p class="hi-faqgroup-sub">{{ cat_sub }}</p>
              {%- endif -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.category == cat_id -%}
                  <div class="hi-faq" {{ block.shopify_attributes }}>
                    <button
                      class="hi-faq-btn"
                      type="button"
                      aria-expanded="false"
                      aria-controls="faqp-{{ block.id }}"
                      data-faq-btn
                    >
                      {{ block.settings.question }}
                      <span class="hi-faq-ic" aria-hidden="true">+</span>
                    </button>
                    <div class="hi-faq-panel" id="faqp-{{ block.id }}" hidden>
                      <div class="hi-faq-answer">{{ block.settings.answer }}</div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- Still Need Help CTA -->
        <div class="hi-faqcta">
          {%- if section.settings.cta_eyebrow != blank -%}
            <div class="hi-faqcta-eyebrow">{{ section.settings.cta_eyebrow }}</div>
          {%- endif -%}
          {%- if section.settings.cta_heading != blank -%}
            <h2 class="hi-faqcta-heading">{{ section.settings.cta_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.cta_body != blank -%}
            <p class="hi-faqcta-body">{{ section.settings.cta_body }}</p>
          {%- endif -%}
          {%- if section.settings.cta_button_label != blank -%}
            <a href="{{ section.settings.cta_button_url | default: '/pages/contact' }}" class="hi-btn hi-btn--accent hi-faqcta-btn">{{ section.settings.cta_button_label }}</a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.hi-faqbody { background: #FBF9F5; }
.hi-faqbody-inner { max-width: 1280px; margin: 0 auto; padding: 64px 32px 80px; }
.hi-faqlayout {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 56px;
  align-items: start;
}
.hi-catnav {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hi-catlink {
  text-align: left;
  background: none;
  border: none;
  border-left: 2px solid #E7E2D7;
  cursor: pointer;
  padding: 12px 16px;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #6B675C;
  transition: color .2s ease, border-color .2s ease, background .2s ease;
}
.hi-catlink:hover { color: #16150F; background: #F1ECE1; }
.hi-catlink[data-on="true"] { color: #16150F; border-left-color: #5C6B47; background: #F1ECE1; }
.hi-faqgroup { margin-bottom: 52px; scroll-margin-top: 150px; }
.hi-faqgroup-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: clamp(20px, 2.4vw, 28px);
  text-transform: uppercase;
  letter-spacing: .03em;
  color: #16150F;
  margin: 0 0 6px;
}
.hi-faqgroup-sub {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 14.5px;
  color: #8A8479;
  margin: 0 0 18px;
  line-height: 1.55;
}
.hi-faq { border-top: 1px solid #E7E2D7; }
.hi-faq:last-of-type { border-bottom: 1px solid #E7E2D7; }
.hi-faq-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  padding: 22px 0;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 15px;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #16150F;
  text-align: left;
}
.hi-faq-ic {
  font-size: 22px;
  font-weight: 300;
  line-height: 1;
  color: #5C6B47;
  transition: transform .3s ease;
  flex-shrink: 0;
  display: inline-block;
}
.hi-faq-btn[aria-expanded="true"] .hi-faq-ic { transform: rotate(45deg); }
.hi-faq-panel { }
.hi-faq-answer {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 15px;
  line-height: 1.75;
  color: #54504A;
  max-width: 70ch;
  padding: 0 0 22px;
}
.hi-faqcta {
  background: #16150F;
  color: #F3EFE6;
  text-align: center;
  padding: 56px 40px;
}
.hi-faqcta-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #9AA585;
  margin-bottom: 14px;
}
.hi-faqcta-heading {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: clamp(24px, 3vw, 36px);
  line-height: 1.05;
  margin: 0 0 14px;
  color: #fff;
}
.hi-faqcta-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 16px;
  line-height: 1.65;
  color: #B6B1A4;
  margin: 0 auto 28px;
  max-width: 44ch;
}
.hi-faqcta-btn:hover { background: #FBF9F5 !important; color: #16150F !important; }
.hi-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 36px;
  text-decoration: none;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
  border: none;
  transition: background .28s cubic-bezier(.2,.7,.3,1), color .28s cubic-bezier(.2,.7,.3,1);
}
.hi-btn--accent { background: #5C6B47; color: #fff; }
.hi-btn--accent:hover { background: #16150F; color: #fff; }
@media (max-width: 900px) {
  .hi-faqbody-inner { padding: 44px 20px 56px; }
  .hi-faqlayout { grid-template-columns: 1fr; gap: 24px; }
  .hi-catnav {
    position: static;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 8px;
    padding-bottom: 2px;
    margin: 0 -20px;
    padding-left: 20px;
    padding-right: 20px;
  }
  .hi-catnav::-webkit-scrollbar { display: none; }
  .hi-catlink {
    border-left: none;
    border: 1px solid #E7E2D7;
    padding: 9px 16px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hi-catlink[data-on="true"] { border-color: #16150F; background: #F1ECE1; }
  .hi-faqgroup { scroll-margin-top: 80px; }
  .hi-faqcta { padding: 44px 24px; }
}
{% endstylesheet %}

{% javascript %}
(function() {
  var btns = document.querySelectorAll('[data-faq-btn]');
  btns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var panelId = btn.getAttribute('aria-controls');
      var panel = document.getElementById(panelId);
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (panel) panel.hidden = expanded;
    });
  });

  var catBtns = document.querySelectorAll('[data-cat-btn]');
  function setActive(targetId) {
    catBtns.forEach(function(b) {
      b.setAttribute('data-on', b.getAttribute('data-target') === targetId ? 'true' : 'false');
    });
  }
  catBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var targetId = btn.getAttribute('data-target');
      var el = document.getElementById(targetId);
      if (el) {
        var top = el.getBoundingClientRect().top + window.scrollY - 140;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
      setActive(targetId);
    });
  });

  if ('IntersectionObserver' in window) {
    var groups = document.querySelectorAll('[data-faq-group]');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { rootMargin: '-20% 0px -60% 0px' });
    groups.forEach(function(g) { observer.observe(g); });
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:hi.hi_faq_body.name",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
