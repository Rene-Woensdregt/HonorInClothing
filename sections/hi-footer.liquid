<footer class="hi-footer">
  <div class="hi-foot-grid">
    <!-- Brand column -->
    <div class="hi-foot-brand">
      <div>
        <div class="hi-foot-brand-name-1">HONOR IN</div>
        <div class="hi-foot-brand-name-2">CLOTHING CO.</div>
      </div>
      {%- if section.settings.tagline != blank -%}
        <p class="hi-foot-tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <div class="hi-foot-socials">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="hi-social" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" class="hi-social" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.twitter_url != blank -%}
          <a href="{{ section.settings.twitter_url }}" class="hi-social" target="_blank" rel="noopener" aria-label="X (Twitter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.5 3H21l-7 8.5L22 21h-5l-4.5-5.8L7 21H3l7.5-8.8L2 3h5.1L11.5 8.4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" class="hi-social" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3V9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Nav columns -->
    {%- for col in (1..4) -%}
      {%- assign title_key = 'col_' | append: col | append: '_title' -%}
      <div class="hi-foot-col">
        <div class="hi-foot-col-title">{{ section.settings[title_key] }}</div>
        {%- for link in (1..4) -%}
          {%- assign label_key = 'col_' | append: col | append: '_link_' | append: link | append: '_label' -%}
          {%- assign url_key = 'col_' | append: col | append: '_link_' | append: link | append: '_url' -%}
          {%- assign link_label = section.settings[label_key] -%}
          {%- assign link_url = section.settings[url_key] -%}
          {%- if link_label != blank -%}
            <a href="{{ link_url }}" class="hi-foot-link">{{ link_label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="hi-foot-legal">
    <span>{{ section.settings.copyright }}</span>
    {%- if section.settings.payments_text != blank -%}
      <span class="hi-foot-payments">{{ section.settings.payments_text }}</span>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
.hi-footer { background: #16150F; color: #CFC9BC; }
.hi-foot-brand-name-1 {
  font-family: 'Oswald', sans-serif;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: .18em;
  color: #fff;
}
.hi-foot-brand-name-2 {
  font-family: 'Oswald', sans-serif;
  font-size: 9.5px;
  font-weight: 400;
  letter-spacing: .42em;
  color: #5C6B47;
  margin-top: 4px;
}
.hi-foot-tagline {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 14.5px;
  font-weight: 400;
  line-height: 1.7;
  color: #9A958A;
  margin: 0;
  max-width: 244px;
}
.hi-foot-socials { display: flex; gap: 10px; flex-wrap: wrap; }
.hi-foot-col { display: flex; flex-direction: column; }
.hi-foot-payments { color: #54504A; }
@media (max-width: 560px) {
  .hi-foot-grid { grid-template-columns: 1fr 1fr; }
}
{% endstylesheet %}

