<footer class="hi-footer">
  <div class="hi-foot-inner">
    <div class="hi-foot-grid">

      <div class="hi-foot-brand">
        <div>
          <div class="hi-foot-brand-name-1">HONOR IN</div>
          <div class="hi-foot-brand-name-2">CLOTHING CO.</div>
        </div>
        {%- if section.settings.tagline != blank -%}
          <p class="hi-foot-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- assign has_social = false -%}
        {%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_twitter_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}
        {%- if has_social -%}
          <div class="hi-foot-socials">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="hi-social" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" class="hi-social" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <a href="{{ settings.social_twitter_link }}" class="hi-social" target="_blank" rel="noopener" aria-label="X (Twitter)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.5 3H21l-7 8.5L22 21h-5l-4.5-5.8L7 21H3l7.5-8.8L2 3h5.1L11.5 8.4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a href="{{ settings.social_youtube_link }}" class="hi-social" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3V9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link }}" class="hi-social" target="_blank" rel="noopener" aria-label="TikTok">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="hi-foot-col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <div class="hi-foot-col-title">{{ block.settings.title }}</div>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <nav>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}" class="hi-foot-link">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          {%- endif -%}
        </div>
      {%- endfor -%}

    </div>
  </div>

  <div class="hi-foot-legal-wrap">
    <div class="hi-foot-legal">
      {%- if section.settings.copyright != blank -%}
        <span>{{ section.settings.copyright }}</span>
      {%- endif -%}
      {%- unless shop.enabled_payment_types == empty -%}
        <div class="hi-foot-payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'hi-payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endunless -%}
    </div>
  </div>
</footer>

{% stylesheet %}
.hi-footer { background: #16150F; color: #CFC9BC; }
.hi-foot-inner { max-width: 1280px; margin: 0 auto; }
.hi-foot-grid {
  display: grid;
  grid-template-columns: 182px repeat(4, 1fr);
  gap: 40px;
  padding: 72px 32px 36px;
}
.hi-foot-brand { display: flex; flex-direction: column; gap: 20px; }
.hi-foot-brand-name-1 {
  font-family: 'Oswald', sans-serif;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: .18em;
  color: #FBF9F5;
}
.hi-foot-brand-name-2 {
  font-family: 'Oswald', sans-serif;
  font-size: 9.5px;
  font-weight: 400;
  letter-spacing: .42em;
  color: #5C6B47;
  margin-top: 4px;
}
.hi-foot-tagline {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 14.5px;
  line-height: 1.7;
  color: #9A958A;
  margin: 0;
  max-width: 200px;
}
.hi-foot-socials { display: flex; gap: 8px; flex-wrap: wrap; }
.hi-social {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 4px;
  color: #FBF9F5;
  text-decoration: none;
  flex-shrink: 0;
  transition: border-color .2s;
}
.hi-social:hover { border-color: rgba(255,255,255,.42); }
.hi-foot-col { display: flex; flex-direction: column; }
.hi-foot-col-title {
  font-family: 'Oswald', sans-serif;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #FBF9F5;
  margin-bottom: 22px;
}
.hi-foot-col nav { display: flex; flex-direction: column; gap: 11px; }
.hi-foot-link {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 14.5px;
  color: #9A958A;
  text-decoration: none;
  display: inline-block;
  width: max-content;
  transition: color .2s, transform .2s;
}
.hi-foot-link:hover { color: #fff; transform: translateX(5px); }
.hi-foot-legal-wrap { border-top: 1px solid rgba(255,255,255,.08); }
.hi-foot-legal {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 32px;
  max-width: 1280px;
  margin: 0 auto;
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 13px;
  color: #54504A;
}
.hi-foot-payments { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.hi-payment-icon { height: 24px; width: auto; border-radius: 3px; }
@media (max-width: 900px) {
  .hi-foot-grid { grid-template-columns: 1fr 1fr; gap: 36px; padding: 48px 32px 40px; }
  .hi-foot-brand { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 24px; }
  .hi-foot-tagline { max-width: 100%; }
}
@media (max-width: 560px) {
  .hi-foot-grid { gap: 28px; padding: 40px 24px 32px; }
  .hi-foot-brand { flex-direction: column; gap: 18px; }
  .hi-foot-tagline { max-width: 260px; }
  .hi-foot-legal { flex-direction: column; gap: 8px; text-align: center; padding: 16px 24px; }
  .hi-foot-payments { justify-content: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "placeholder": "e.g. Honor in everything you do.",
      "default": "Honor in everything you do. Premium active lifestyle apparel for people who live with purpose.",
      "info": "Shown below the logo in the brand column"
    },
    {
      "type": "paragraph",
      "content": "Social media icons are pulled from Theme settings → Social media. Add your links there."
    },
    {
      "type": "header",
      "content": "Legal bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "placeholder": "e.g. © 2026 Honor In Clothing Co. All rights reserved.",
      "default": "© 2026 Honor In Clothing Co. All rights reserved."
    },
    {
      "type": "paragraph",
      "content": "Payment method logos are pulled automatically from your enabled payment providers in Shopify Payments settings."
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "nav_column",
      "name": "Nav column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "placeholder": "e.g. Shop",
          "info": "Displayed in small uppercase (Oswald)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation menu",
          "info": "Create or edit menus in Shopify Admin → Online Store → Navigation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
