
<div class="hi-cart-backdrop" data-hi-cart-backdrop></div>
<aside class="hi-cart" data-hi-cart role="dialog" aria-modal="true" aria-label="{{ 'hi.cart_drawer.title' | t }}">

  {%- comment -%}── Head ──{%- endcomment -%}
  <div class="hi-cart-head">
    <div class="hi-cart-head-title">
      {{ 'hi.cart_drawer.title' | t }}
      <span class="hi-cart-head-count">({{ cart.item_count }})</span>
    </div>
    <button type="button" class="hi-drawer-close" data-hi-cart-close aria-label="{{ 'hi.general.close_cart' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  {%- if cart.item_count > 0 -%}

    {%- comment -%}── Items ──{%- endcomment -%}
    <div class="hi-cart-items">
      {%- for item in cart.items -%}
        <div class="hi-cart-item" data-cart-item data-key="{{ item.key }}">
          <div class="hi-cart-thumb">
            {%- if item.image != blank -%}
              {{ item.image | image_url: width: 200 | image_tag:
                  loading: 'lazy',
                  alt: item.title,
                  style: 'width:100%;height:100%;object-fit:cover;display:block;' }}
            {%- endif -%}
          </div>
          <div class="hi-cart-item-info">
            <div class="hi-cart-item-top">
              <div class="hi-cart-item-name">{{ item.product.title }}</div>
              <div class="hi-cart-item-price">{{ item.final_line_price | money }}</div>
            </div>
            {%- unless item.variant.title == 'Default Title' -%}
              <div class="hi-cart-item-meta">{{ item.variant.title }}</div>
            {%- endunless -%}
            <div class="hi-cart-item-unit">{{ item.price | money }} / ea</div>
            <div class="hi-cart-item-bottom">
              <div class="hi-cqty">
                <button type="button" data-qty-change="-" aria-label="{{ 'hi.general.decrease_qty' | t }}">−</button>
                <span data-qty-val>{{ item.quantity }}</span>
                <button type="button" data-qty-change="+" aria-label="{{ 'hi.general.increase_qty' | t }}">+</button>
              </div>
              <button type="button" class="hi-cart-remove" data-remove-item="{{ item.key }}">{{ 'hi.general.remove' | t }}</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%}── Footer ──{%- endcomment -%}
    <div class="hi-cart-foot">
      <div class="hi-cart-subtotal-row">
        <span class="hi-cart-subtotal-label">{{ 'hi.cart_drawer.subtotal' | t }}</span>
        <span class="hi-cart-subtotal-price">{{ cart.total_price | money }}</span>
      </div>

      <a href="/checkout" class="hi-btn hi-btn--primary hi-btn--full">{{ section.settings.checkout_label }}</a>
      <button type="button" class="hi-cart-continue" data-hi-cart-close>{{ 'hi.general.continue_shopping' | t }}</button>
    </div>

  {%- else -%}

    {%- comment -%}── Empty state ──{%- endcomment -%}
    <div class="hi-cart-empty">
      <div class="hi-cart-empty-title">{{ 'hi.cart_drawer.empty_heading' | t }}</div>
      <div class="hi-cart-empty-body">{{ 'hi.cart_drawer.empty_body' | t }}</div>
      <a href="/collections/all" class="hi-btn hi-btn--primary" data-hi-cart-close>{{ 'hi.cart_drawer.start_shopping' | t }}</a>
    </div>

  {%- endif -%}

</aside>

{% stylesheet %}
/* ─────────── Cart backdrop ─────────── */
.hi-cart-backdrop {
  display: block !important;
  position: fixed; inset: 0;
  background: rgba(12,12,9,.5);
  opacity: 0; pointer-events: none;
  transition: opacity .3s ease;
  z-index: 201;
}
.hi-cart-backdrop--open { opacity: 1; pointer-events: auto; }

/* ─────────── Cart panel ─────────── */
.hi-cart {
  position: fixed; top: 0; right: 0; bottom: 0;
  width: 380px;
  background: #FBF9F5;
  z-index: 202;
  transform: translateX(100%);
  transition: transform .36s cubic-bezier(.2,.7,.3,1);
  display: flex; flex-direction: column;
}
@media (max-width: 480px) {
  .hi-cart { width: 85% !important; }
}
.hi-cart--open {
  transform: none;
  box-shadow: 0 0 60px rgba(12,12,9,.34);
}

/* ─────────── Head ─────────── */
.hi-cart-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22px 24px;
  border-bottom: 1px solid #E7E2D7;
  flex-shrink: 0;
}
.hi-cart-head-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 700; font-size: 17px;
  letter-spacing: .12em; text-transform: uppercase;
  color: #16150F; line-height: 1;
}
.hi-cart-head-count { color: #8A8479; }


/* ─────────── Items list ─────────── */
.hi-cart-items { flex: 1; overflow-y: auto; }
.hi-cart-item {
  display: flex; gap: 16px;
  padding: 20px 24px;
  border-bottom: 1px solid #ECE7DC;
}
.hi-cart-thumb {
  width: 78px; height: 98px;
  background: #E9E4DA; flex-shrink: 0; overflow: hidden;
}
.hi-cart-item-info {
  flex: 1; display: flex; flex-direction: column; min-width: 0;
}
.hi-cart-item-top {
  display: flex; justify-content: space-between; gap: 12px;
}
.hi-cart-item-name {
  font-weight: 600; font-size: 15px; line-height: 1.3; color: #16150F;
}
.hi-cart-item-price {
  font-weight: 600; font-size: 15px;
  white-space: nowrap; color: #16150F; line-height: 1.3;
}
.hi-cart-item-meta {
  font-size: 12.5px; color: #8A8479;
  margin-top: 4px; line-height: 1.3; letter-spacing: 0;
}
.hi-cart-item-bottom {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: auto; padding-top: 16px;
}

/* ─────────── Qty control ─────────── */
.hi-cqty {
  display: inline-flex; align-items: center;
  border: 1px solid #D7D0C2;
}
.hi-cqty button {
  width: 30px; height: 30px;
  border: none; background: none; cursor: pointer;
  font-size: 17px; color: #16150F; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s ease;
}
.hi-cqty button:hover { background: #F1ECE1; }
.hi-cqty button:first-child:hover {
  box-shadow: inset 0 1px 0 0 #D7D0C2, inset 0 -1px 0 0 #D7D0C2, inset -1px 0 0 0 #D7D0C2;
}
.hi-cqty button:last-child:hover {
  box-shadow: inset 0 1px 0 0 #D7D0C2, inset 0 -1px 0 0 #D7D0C2, inset 1px 0 0 0 #D7D0C2;
}
.hi-cqty span {
  min-width: 32px; text-align: center;
  font-family: 'Oswald', sans-serif;
  font-size: 14px; line-height: 1; letter-spacing: 0;
}

/* ─────────── Remove button ─────────── */
.hi-cart-remove {
  background: none; border: none; cursor: pointer;
  color: #8A8479; font-size: 12px;
  letter-spacing: .04em; text-decoration: underline;
  padding: 0; text-underline-offset: 2px;
  transition: color .2s ease; line-height: 1;
  font-family: 'Hanken Grotesk', sans-serif;
}
.hi-cart-remove:hover { color: #16150F; }

/* ─────────── Footer ─────────── */
.hi-cart-foot {
  border-top: 1px solid #E7E2D7;
  padding: 22px 24px;
  flex-shrink: 0;
}
.hi-cart-subtotal-row {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 20px;
}
.hi-cart-subtotal-label {
  font-family: 'Oswald', sans-serif;
  font-size: 13px; letter-spacing: .12em;
  text-transform: uppercase; color: #54504A; line-height: 1;
}
.hi-cart-subtotal-price {
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 21px; line-height: 1;
}
.hi-cart-continue {
  display: block; width: 100%;
  background: none; border: none; cursor: pointer;
  margin-top: 12px; color: #16150F;
  font-family: 'Oswald', sans-serif;
  font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase;
  text-decoration: underline; text-underline-offset: 3px;
  padding: 6px; line-height: 1;
}

/* ─────────── Empty state ─────────── */
.hi-cart-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; padding: 40px; gap: 16px;
}
.hi-cart-empty-title {
  font-family: 'Oswald', sans-serif;
  font-size: 20px; text-transform: uppercase; letter-spacing: .06em; line-height: 1;
}
.hi-cart-empty-body {
  color: #8A8479; font-size: 14.5px; line-height: 1.6;
  max-width: 30ch; letter-spacing: 0;
}

.hi-btn--full { width: 100%; }

/* ─────────── Unit price ─────────── */
.hi-cart-item-unit {
  font-size: 12px;
  color: #8A8479;
  margin-top: 3px;
  letter-spacing: 0;
  line-height: 1.3;
}

/* ─────────── Loading spinners (subtotal + item price) ─────────── */
.hi-cart--updating .hi-cart-subtotal-price,
.hi-cart--updating .hi-cart-item-price {
  position: relative;
  color: transparent;
}
.hi-cart--updating .hi-cart-subtotal-price::after,
.hi-cart--updating .hi-cart-item-price::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  border: 1.5px solid rgba(22, 21, 15, 0.15);
  border-top-color: #16150F;
  border-radius: 50%;
  animation: hi-cart-spin 0.65s linear infinite;
}
.hi-cart--updating .hi-cart-subtotal-price::after {
  width: 1.4rem;
  height: 1.4rem;
  margin-top: -0.7rem;
}
.hi-cart--updating .hi-cart-item-price::after {
  width: 1.1rem;
  height: 1.1rem;
  margin-top: -0.55rem;
}
@keyframes hi-cart-spin {
  to { transform: rotate(360deg); }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  function getDrawer()   { return document.querySelector('[data-hi-cart]'); }
  function getBackdrop() { return document.querySelector('[data-hi-cart-backdrop]'); }

  /* Escape the header stacking context so z-index works correctly */
  (function () {
    var b = getBackdrop(), d = getDrawer();
    if (b) document.body.appendChild(b);
    if (d) document.body.appendChild(d);
  })();

  function open() {
    var d = getDrawer(), b = getBackdrop();
    if (!d) return;
    d.classList.add('hi-cart--open');
    if (b) b.classList.add('hi-cart-backdrop--open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    var d = getDrawer(), b = getBackdrop();
    if (!d) return;
    d.classList.remove('hi-cart--open');
    if (b) b.classList.remove('hi-cart-backdrop--open');
    document.body.style.overflow = '';
  }

  function isOpen() {
    var d = getDrawer();
    return d && d.classList.contains('hi-cart--open');
  }

  /* Refresh cart via Shopify section rendering — no page reload */
  function refreshCart() {
    var d = getDrawer();
    var wasOpen = d && d.classList.contains('hi-cart--open');
    if (d) d.classList.add('hi-cart--updating');
    fetch('/?sections=hi-cart-drawer')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var temp = document.createElement('div');
        temp.innerHTML = data['hi-cart-drawer'];
        temp.querySelectorAll('script, style').forEach(function (el) { el.remove(); });
        var newBackdrop = temp.querySelector('[data-hi-cart-backdrop]');
        var newDrawer   = temp.querySelector('[data-hi-cart]');
        var curBackdrop = getBackdrop();
        var curDrawer   = getDrawer();
        if (curBackdrop && newBackdrop) curBackdrop.replaceWith(newBackdrop);
        if (curDrawer   && newDrawer)   curDrawer.replaceWith(newDrawer);
        if (wasOpen) {
          /* Drawer was already open — snap to open state, no slide animation */
          if (newDrawer) { newDrawer.style.transition = 'none'; newDrawer.classList.add('hi-cart--open'); }
          if (newBackdrop) { newBackdrop.style.transition = 'none'; newBackdrop.classList.add('hi-cart-backdrop--open'); }
          document.body.style.overflow = 'hidden';
          /* Restore transitions after next paint so close still animates */
          requestAnimationFrame(function () {
            if (newDrawer) newDrawer.style.transition = '';
            if (newBackdrop) newBackdrop.style.transition = '';
          });
        } else {
          /* Drawer was closed — let CSS transition play the slide-in */
          requestAnimationFrame(function () { open(); });
        }
        /* Update header cart badge */
        return fetch('/cart.js');
      })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var badge = document.querySelector('[data-cart-count]');
        if (badge) badge.textContent = cart.item_count;
      });
  }

  /* Expose for PDP and other sections to trigger after add-to-cart */
  window.hiRefreshCart = function() { refreshCart(); };
  window.hiOpenCart = open;

  /* Open on cart icon click */
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-hi-cart-trigger]')) {
      e.preventDefault();
      open();
    }
  });

  /* Close on close buttons */
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-hi-cart-close]')) close();
  });

  /* Close on tap/click outside the drawer */
  document.addEventListener('pointerdown', function (e) {
    if (!isOpen()) return;
    var d = getDrawer();
    var trigger = document.querySelector('[data-hi-cart-trigger]');
    if (d && d.contains(e.target)) return;
    if (trigger && trigger.contains(e.target)) return;
    close();
  });

  /* Qty change */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-qty-change]');
    if (!btn) return;
    var item = btn.closest('[data-cart-item]');
    if (!item) return;
    var key   = item.dataset.key;
    var qtyEl = item.querySelector('[data-qty-val]');
    var qty   = parseInt(qtyEl.textContent, 10) + (btn.dataset.qtyChange === '+' ? 1 : -1);
    if (qty < 0) qty = 0;
    var d = getDrawer();
    if (d) d.classList.add('hi-cart--updating');
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: key, quantity: qty})
    }).then(refreshCart);
  });

  /* Remove item */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-remove-item]');
    if (!btn) return;
    var d = getDrawer();
    if (d) d.classList.add('hi-cart--updating');
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: btn.dataset.removeItem, quantity: 0})
    }).then(refreshCart);
  });

})();
{% endjavascript %}

{% schema %}
{
  "name": "t:hi.cart_drawer.name",
  "settings": [
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Proceed to Checkout"
    }
  ],
  "presets": [
    {
      "name": "t:hi.cart_drawer.name"
    }
  ]
}
{% endschema %}
