    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.hi_product_main.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "richtext",
      "id": "materials_content",
      "label": "t:sections.hi_product_main.settings.materials_content.label",
      "info": "t:sections.hi_product_main.settings.materials_content.info"
    },
    {
      "type": "richtext",
      "id": "shipping_content",
      "label": "t:sections.hi_product_main.settings.shipping_content.label"
    },
    {
      "type": "html",
      "id": "size_guide_content",
      "label": "t:sections.hi_product_main.settings.size_guide_content.label",
      "info": "t:sections.hi_product_main.settings.size_guide_content.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hi_product_main.name"
    }
  ]
}
