  background: #FBF9F5;
  max-width: 640px;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
}
.hi-size-guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 26px;
  border-bottom: 1px solid #E7E2D7;
  position: sticky;
  top: 0;
  background: #FBF9F5;
}
.hi-size-guide-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  font-size: 18px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #16150F;
}
.hi-size-guide-body { padding: 26px; }
.hi-size-table { border: 1px solid #E7E2D7; }
.hi-size-table-head {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  background: #16150F;
  color: #fff;
  font-family: 'Oswald', sans-serif;
  font-size: 12px;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.hi-size-table-head div { padding: 12px 14px; }
.hi-size-table-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  border-top: 1px solid #ECE7DC;
  font-size: 14px;
}
.hi-size-table-row div { padding: 12px 14px; color: #54504A; }
.hi-size-table-row div:first-child {
