  /* Reds, Pinks & Purples */
  --hi-swatch-berry: #8B3A5E;
  --hi-swatch-bone: #E0D5C5;
  --hi-swatch-cancun: #48B0AA;
  --hi-swatch-cranberry: #8B1C3C;
  --hi-swatch-crimson: #9B1B1B;
  --hi-swatch-crunchberry: #C04B79;
  --hi-swatch-heather-mauve: #B08A9A;
  --hi-swatch-light-pink: #F0AABB;
  --hi-swatch-maroon: #6B1B2A;
  --hi-swatch-neon-orange: #FF5A00;
  --hi-swatch-neon-yellow: #D0DD00;
  --hi-swatch-orchid: #B077A3;
  --hi-swatch-pigment-maroon: #6B1B2A;
  --hi-swatch-pigment-pink: #D98A9E;
  --hi-swatch-pink: #F0AABB;
  --hi-swatch-purple-rush: #6B3A9A;
  --hi-swatch-scarlet: #B31B1B;
  --hi-swatch-squash: #C4882A;
  --hi-swatch-team-red: #B31B1B;
  --hi-swatch-vintage-red: #8B2020;
  --hi-swatch-vintage-royal: #26388B;
  --hi-swatch-violet: #5A3D8B;

  /* Two-tone / compound colors (split swatch) */
  --hi-swatch-black-charcoal: linear-gradient(to right, #16150F 50%, #3C3A35 50%);
  --hi-swatch-black-white: linear-gradient(to right, #16150F 50%, #FFFFFF 50%);
  --hi-swatch-charcoal-black: linear-gradient(to right, #3C3A35 50%, #16150F 50%);
  --hi-swatch-burgundy-heather-grey: linear-gradient(to right, #6B2737 50%, #9A9A9A 50%);
  --hi-swatch-fire-red-arctic-white: linear-gradient(to right, #B31B1B 50%, #F5F2EE 50%);
  --hi-swatch-heather-grey-black: linear-gradient(to right, #9A9A9A 50%, #16150F 50%);
  --hi-swatch-heather-grey-white: linear-gradient(to right, #9A9A9A 50%, #FFFFFF 50%);
  --hi-swatch-jet-black-arctic-white: linear-gradient(to right, #2A2825 50%, #F5F2EE 50%);
  --hi-swatch-jet-black-fire-red: linear-gradient(to right, #2A2825 50%, #B31B1B 50%);
  --hi-swatch-jet-black-heather-grey: linear-gradient(to right, #2A2825 50%, #9A9A9A 50%);
  --hi-swatch-kelly-green-arctic-white: linear-gradient(to right, #2D7A2D 50%, #F5F2EE 50%);
  --hi-swatch-oxford-navy-heather-grey: linear-gradient(to right, #1F3A6E 50%, #9A9A9A 50%);
  --hi-swatch-royal-blue-arctic-white: linear-gradient(to right, #2A4EA8 50%, #F5F2EE 50%);
}

.hi-pdp-breadcrumb-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 22px 32px 0;
}
.hi-breadcrumb {
  font-family: 'Oswald', sans-serif;
  font-weight: 500;
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #8A8479;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.hi-breadcrumb-link {
  color: #8A8479;
  text-decoration: none;
  transition: color .2s ease;
}
.hi-breadcrumb-link:hover { color: #16150F; }
.hi-breadcrumb-current { color: #16150F; }

.hi-pdp-main {
  max-width: 1280px;
  margin: 0 auto;
  padding: 30px 32px 70px;
}
.hi-pdp-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 56px;
  align-items: start;
}

/* Gallery */
.hi-gallery {
  display: grid;
  grid-template-columns: 84px 1fr;
  gap: 16px;
  align-items: start;
}
.hi-tcarousel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.hi-tcarousel-btn {
  width: 100%;
  height: 26px;
  background: none;
  border: 1px solid #E7E2D7;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #16150F;
  transition: background .2s ease;
  flex-shrink: 0;
  padding: 0;
}
.hi-tcarousel-btn:hover:not(:disabled) { background: #F3EFE6; }
.hi-tcarousel-btn:disabled { opacity: .3; cursor: default; }
.hi-thumbs-viewport {
  width: 100%;
  overflow: hidden;
  /* cap at 4 visible thumbs; shrinks when fewer exist */
  max-height: 484px;
}
.hi-thumbs {
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform .3s cubic-bezier(.2,.7,.3,1);
}
.hi-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #E9E4DA;
  cursor: pointer;
  border: 1.5px solid transparent;
  transition: border-color .2s ease;
}
.hi-thumb--active { border-color: #16150F; }
.hi-thumb .img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: opacity .2s ease;
}
.hi-thumb:hover .img { opacity: .82; }

.hi-gallery-main {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #E9E4DA;
  cursor: zoom-in;
}
.hi-gallery-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity .35s ease;
}
.hi-gallery-slide--active { opacity: 1; }
.hi-gallery-slide .img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
}

.hi-badge {
  position: absolute;
  top: 18px;
  left: 18px;
  background: #5C6B47;
  color: #fff;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 6px 12px;
  z-index: 2;
  pointer-events: none;
}

/* Buy box */
.hi-buybox { position: sticky; top: 100px; }
.hi-buybox-cat {
  font-family: 'Oswald', sans-serif;
  font-weight: 500;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: #5C6B47;
}
.hi-buybox-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  font-size: clamp(28px, 3.4vw, 42px);
  line-height: 1.02;
  letter-spacing: .01em;
  margin: 10px 0 0;
  color: #16150F;
}
.hi-buybox-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-top: 20px;
}
.hi-price-main {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 28px;
  color: #16150F;
}
.hi-price-compare {
  font-size: 17px;
  color: #A39E92;
  text-decoration: line-through;
}
.hi-buybox-blurb {
  font-size: 16px;
  line-height: 1.7;
  color: #54504A;
  margin: 20px 0 0;
  max-width: 52ch;
}

/* Option groups */
.hi-option-group { margin-top: 28px; }
.hi-option-label {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #16150F;
  margin-bottom: 14px;
  display: block;
}
.hi-colors { display: flex; gap: 16px; flex-wrap: wrap; }
.hi-color {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  cursor: pointer;
}
.hi-color .dot {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,.15);
  transition: transform .18s ease, box-shadow .18s ease;
}
.hi-color:hover .dot { transform: scale(1.08); }
.hi-color--active .dot { box-shadow: 0 0 0 2px #FBF9F5, 0 0 0 3.5px #16150F; }

.hi-sizes { display: flex; flex-wrap: wrap; gap: 10px; }
.hi-size {
  min-width: 52px;
  height: 48px;
  padding: 0 12px;
  border: 1px solid #D7D0C2;
  background: #fff;
  cursor: pointer;
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  letter-spacing: .04em;
  color: #3A372F;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all .18s ease;
}
.hi-size:hover:not(:disabled) { border-color: #16150F; }
.hi-size--active { background: #16150F; border-color: #16150F; color: #fff; }
.hi-size--soldout { opacity: .4; cursor: not-allowed; text-decoration: line-through; }

.hi-sizeguide-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 13px;
  color: #6B675C;
  text-decoration: underline;
  text-underline-offset: 2px;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'Hanken Grotesk', sans-serif;
  transition: color .2s ease;
}
.hi-sizeguide-btn:hover { color: #16150F; }
.hi-size-error { color: #A6552F; font-size: 13px; margin-top: 10px; }

/* Buy row */
.hi-buyrow {
  display: flex;
  gap: 12px;
  margin-top: 30px;
  align-items: stretch;
}
.hi-qty {
  display: inline-flex;
  align-items: center;
  border: 1px solid #D7D0C2;
  height: 56px;
}
.hi-qty button {
  width: 52px;
  height: 100%;
  border: none;
  background: none;
  cursor: pointer;
  font-size: 20px;
  color: #16150F;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s ease;
}
.hi-qty button:hover { background: #F1ECE1; }
.hi-qty span {
  min-width: 46px;
  text-align: center;
  font-size: 16px;
  font-family: 'Oswald', sans-serif;
}
.hi-addbtn { flex: 1; white-space: nowrap; }

/* Trust box */
.hi-trust-box {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 32px;
  padding: 24px;
  background: #F1ECE1;
}
.hi-trust { display: flex; align-items: flex-start; gap: 12px; }
.hi-trust svg {
  width: 22px;
  height: 22px;
  color: #5C6B47;
  flex-shrink: 0;
  margin-top: 1px;
}
.hi-trust-title { font-weight: 600; font-size: 14px; color: #16150F; }
.hi-trust-desc { font-size: 13px; color: #8A8479; margin-top: 2px; }

/* Accordions */
.hi-accs { margin-top: 34px; }
.hi-acc { border-top: 1px solid #E7E2D7; }
.hi-acc:last-child { border-bottom: 1px solid #E7E2D7; }
.hi-acc-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  padding: 20px 0;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #16150F;
  text-align: left;
}
.hi-acc-icon {
  font-size: 20px;
  font-weight: 300;
  line-height: 1;
  color: #5C6B47;
  transition: transform .3s ease;
  flex-shrink: 0;
}
.hi-acc-btn[data-open="true"] .hi-acc-icon { transform: rotate(45deg); }
.hi-acc-panel {
  overflow: hidden;
  max-height: 0;
  transition: max-height .34s cubic-bezier(.2,.7,.3,1);
}
.hi-acc-panel[data-open="true"] { max-height: 1200px; }
.hi-acc-content {
  padding: 0 0 22px;
  font-size: 15px;
  line-height: 1.75;
  color: #54504A;
}
.hi-rte p { margin: 0 0 12px; }
.hi-rte ul, .hi-rte ol { margin: 0 0 12px; padding-left: 20px; }
.hi-rte li { margin-bottom: 4px; }
.hi-rte { overflow-x: auto; }
.hi-rte table { border-collapse: separate; border-spacing: 0; width: 100%; margin: 16px 0; border: 1px solid #E7E2D7; }
.hi-rte table td,
.hi-rte table th { border-right: 1px solid #E7E2D7; border-bottom: 1px solid #E7E2D7; padding: 10px 14px; text-align: left; font-size: 14px; line-height: 1.4; }
.hi-rte table td:first-child,
.hi-rte table th:first-child { border-left: none; }
.hi-rte table tr:first-child td,
.hi-rte table tr:first-child th { border-top: none; }
.hi-rte table tr:last-child td,
.hi-rte table tr:last-child th { border-bottom: none; }
.hi-rte table td:last-child,
.hi-rte table th:last-child { border-right: none; }
.hi-rte table tr:first-child td,
.hi-rte table th { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; background: #F3EFE6; color: #16150F; }
.hi-rte table tr:nth-child(even):not(:first-child) td { background: #FAFAF8; }
.hi-acc-content .table-responsive { padding-inline: 5px; }

/* Size guide modal */
.hi-size-guide-overlay {
  position: fixed;
  inset: 0;
  background: rgba(12,12,9,.55);
  z-index: 210;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.hi-size-guide-overlay[style*="flex"] { display: flex !important; }
