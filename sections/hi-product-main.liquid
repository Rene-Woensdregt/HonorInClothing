{% javascript %}
(function() {
  'use strict';

  var pdpState = {};

  function initPdp(sectionId) {
    var el = document.getElementById('hi-pdp-json-' + sectionId);
    if (!el) return;

    var data;
    try { data = JSON.parse(el.textContent); } catch(e) { return; }

    var idInput = document.getElementById('hi-variant-id-' + sectionId);
    var initialVariantId = idInput ? parseInt(idInput.value, 10) : null;
    var initialVariant = data.variants.find(function(v) { return v.id === initialVariantId; }) || data.variants[0];

    pdpState[sectionId] = {
      data: data,
      selectedOptions: initialVariant ? [initialVariant.option1, initialVariant.option2, initialVariant.option3] : [null, null, null],
      qty: 1
    };

    // Form submit handler
    var form = document.getElementById('hi-pdp-form-' + sectionId);
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        hiAddToCart(sectionId);
      });
    }

    // Sticky bar observer — show only when buy row is off-screen AND footer is not yet in view
    var buyrow = document.getElementById('hi-buyrow-' + sectionId);
    var stickybar = document.getElementById('hi-stickybar-' + sectionId);
    if (buyrow && stickybar && window.IntersectionObserver) {
      var buyrowVisible = true;
      var footerVisible = false;

      function updateStickyBar() {
        var show = !buyrowVisible && !footerVisible;
        stickybar.classList.toggle('hi-stickybar--show', show);
        stickybar.setAttribute('aria-hidden', show ? 'false' : 'true');
      }

      new IntersectionObserver(function(entries) {
        buyrowVisible = entries[0].isIntersecting;
        updateStickyBar();
      }, { threshold: 0 }).observe(buyrow);

      var footer = document.querySelector('footer, .hi-footer, [class*="hi-foot"]');
      if (footer) {
        new IntersectionObserver(function(entries) {
          footerVisible = entries[0].isIntersecting;
          updateStickyBar();
        }, { threshold: 0 }).observe(footer);
      }
    }
  }

  // Thumbnail carousel
  var hiThumbPos = {};
  var HI_THUMB_H = 112; // 84px wide × 3:4 ratio = 112px tall
  var HI_THUMB_GAP = 12;
  var HI_VISIBLE = 4;

  function hiThumbUpdateBtns(sectionId, pos, total) {
    var btnUp = document.getElementById('hi-tcbtn-up-' + sectionId);
    var btnDown = document.getElementById('hi-tcbtn-down-' + sectionId);
    if (btnUp) btnUp.disabled = pos <= 0;
    if (btnDown) btnDown.disabled = pos >= total - HI_VISIBLE;
  }

  window.hiThumbNav = function(sectionId, dir) {
    if (window.innerWidth <= 640) {
      var viewport = document.querySelector('#hi-tcarousel-' + sectionId + ' .hi-thumbs-viewport');
      if (viewport) viewport.scrollBy({ left: dir * 132, behavior: 'smooth' });
      return;
    }
    var thumbs = document.getElementById('hi-thumbs-' + sectionId);
    if (!thumbs) return;
    var total = thumbs.querySelectorAll('.hi-thumb').length;
    if (total <= HI_VISIBLE) return;
    var pos = (hiThumbPos[sectionId] || 0) + dir;
    pos = Math.min(total - HI_VISIBLE, Math.max(0, pos));
    hiThumbPos[sectionId] = pos;
    thumbs.style.transform = 'translateY(-' + (pos * (HI_THUMB_H + HI_THUMB_GAP)) + 'px)';
    hiThumbUpdateBtns(sectionId, pos, total);
  };

  function hiThumbScrollToActive(sectionId, mediaId) {
    var thumbs = document.getElementById('hi-thumbs-' + sectionId);
    if (!thumbs) return;
    var thumbEls = thumbs.querySelectorAll('.hi-thumb');
    var total = thumbEls.length;
    if (total <= HI_VISIBLE) return;
    var activeIndex = -1;
    thumbEls.forEach(function(t, i) { if (t.dataset.mediaId == mediaId) activeIndex = i; });
    if (activeIndex < 0) return;
    var pos = hiThumbPos[sectionId] || 0;
    if (activeIndex < pos) pos = activeIndex;
    else if (activeIndex >= pos + HI_VISIBLE) pos = activeIndex - HI_VISIBLE + 1;
    if (pos !== (hiThumbPos[sectionId] || 0)) {
      hiThumbPos[sectionId] = pos;
      thumbs.style.transform = 'translateY(-' + (pos * (HI_THUMB_H + HI_THUMB_GAP)) + 'px)';
      hiThumbUpdateBtns(sectionId, pos, total);
    }
  }

  window.hiPdpSelectMedia = function(sectionId, mediaId) {
    document.querySelectorAll('#hi-gallery-' + sectionId + ' .hi-gallery-slide').forEach(function(s) {
      s.classList.toggle('hi-gallery-slide--active', s.dataset.mediaId == mediaId);
    });
    document.querySelectorAll('#hi-gallery-' + sectionId + ' .hi-thumb').forEach(function(t) {
      t.classList.toggle('hi-thumb--active', t.dataset.mediaId == mediaId);
    });
    hiThumbScrollToActive(sectionId, mediaId);
  };

  window.hiPdpSelectOption = function(sectionId, optionIndex, value) {
    var state = pdpState[sectionId];
    if (!state) return;

    state.selectedOptions[optionIndex] = value;

    // Update active classes — toggle only the class that matches the element type
    document.querySelectorAll('[data-section-id="' + sectionId + '"][data-option-index="' + optionIndex + '"]').forEach(function(el) {
      var isActive = el.dataset.value === value;
      if (el.classList.contains('hi-color')) {
        el.classList.toggle('hi-color--active', isActive);
      } else {
        el.classList.toggle('hi-size--active', isActive);
      }
    });

    var variant = findVariant(state);
    if (!variant) return;

    // Update hidden input
    var idInput = document.getElementById('hi-variant-id-' + sectionId);
    if (idInput) idInput.value = variant.id;

    // Update URL with variant ID (matching standard Shopify behavior)
    if (history && history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url.toString());
    }

    // Update price
    var priceMain = document.querySelector('#hi-price-' + sectionId + ' .hi-price-main');
    if (priceMain) priceMain.textContent = variant.price_formatted;
    var compareEl = document.querySelector('#hi-price-' + sectionId + ' .hi-price-compare');
    if (variant.compare_at_price > variant.price) {
      if (!compareEl) {
        compareEl = document.createElement('span');
        compareEl.className = 'hi-price-compare';
        document.getElementById('hi-price-' + sectionId).appendChild(compareEl);
      }
      compareEl.textContent = variant.compare_at_price_formatted;
      compareEl.style.display = '';
    } else if (compareEl) {
      compareEl.style.display = 'none';
    }

    // Update ATC buttons
    var atcText = variant.available ? window.hiI18n.add_to_cart : window.hiI18n.sold_out;
    ['hi-atc-btn-' + sectionId, 'hi-sticky-atc-' + sectionId].forEach(function(id) {
      var btn = document.getElementById(id);
      if (btn) { btn.disabled = !variant.available; btn.textContent = atcText; }
    });

    // Update variant display in sticky bar
    var variantEl = document.getElementById('hi-sticky-variant-' + sectionId);
    if (variantEl) {
      var isDefault = variant.title === 'Default Title';
      variantEl.textContent = isDefault ? '' : variant.title;
      variantEl.style.display = isDefault ? 'none' : '';
    }

    // Switch gallery to variant media
    if (variant.featured_media_id) {
      hiPdpSelectMedia(sectionId, variant.featured_media_id);
    }

    // Update color name
    if (optionIndex === 0) {
      var colorName = document.getElementById('hi-color-name-' + sectionId);
      if (colorName) colorName.textContent = value;
    }

    // Update size availability based on selected color
    updateSizeAvailability(sectionId, state);
  };

  function findVariant(state) {
    var opts = state.selectedOptions;
    return state.data.variants.find(function(v) {
      return (opts[0] === null || v.option1 === opts[0]) &&
             (opts[1] === null || v.option2 === opts[1]) &&
             (opts[2] === null || v.option3 === opts[2]);
    });
  }

  function updateSizeAvailability(sectionId, state) {
    document.querySelectorAll('[data-section-id="' + sectionId + '"][data-option-index="1"]').forEach(function(btn) {
      var sizeVal = btn.dataset.value;
      var avail = state.data.variants.some(function(v) {
        return v.available &&
               (state.selectedOptions[0] === null || v.option1 === state.selectedOptions[0]) &&
               v.option2 === sizeVal;
      });
      btn.disabled = !avail;
      btn.classList.toggle('hi-size--soldout', !avail);
    });
  }

  window.hiPdpDecQty = function(sectionId) {
    var state = pdpState[sectionId];
    if (!state || state.qty <= 1) return;
    state.qty--;
    updateQtyDisplays(sectionId, state.qty);
  };

  window.hiPdpIncQty = function(sectionId) {
    var state = pdpState[sectionId];
    if (!state) return;
    state.qty++;
    updateQtyDisplays(sectionId, state.qty);
  };

  function updateQtyDisplays(sectionId, qty) {
    ['hi-qty-display-' + sectionId, 'hi-sticky-qty-display-' + sectionId].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.textContent = qty;
    });
    var qtyInput = document.getElementById('hi-qty-input-' + sectionId);
    if (qtyInput) qtyInput.value = qty;
  }

  window.hiToggleSizeGuide = function(sectionId) {
    var modal = document.getElementById('hi-size-guide-' + sectionId);
    if (!modal) return;
    var isOpen = modal.style.display === 'flex';
    modal.style.display = isOpen ? 'none' : 'flex';
    document.body.style.overflow = isOpen ? '' : 'hidden';
  };

  window.hiToggleAcc = function(btn) {
    var isOpen = btn.getAttribute('data-open') === 'true';
    btn.setAttribute('data-open', String(!isOpen));
    var panel = btn.nextElementSibling;
    if (panel) panel.setAttribute('data-open', String(!isOpen));
  };

  function doAddToCart(sectionId) {
    var state = pdpState[sectionId];
    if (!state) return;
    var variantId = document.getElementById('hi-variant-id-' + sectionId);
    if (!variantId || !variantId.value) return;

    var btns = [
      document.getElementById('hi-atc-btn-' + sectionId),
      document.getElementById('hi-sticky-atc-' + sectionId)
    ].filter(Boolean);

    btns.forEach(function(b) { b.disabled = true; b.textContent = window.hiI18n.adding; });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: parseInt(variantId.value, 10), quantity: state.qty })
    })
    .then(function(r) { return r.ok ? r.json() : Promise.reject(r); })
    .then(function() {
      btns.forEach(function(b) { b.textContent = window.hiI18n.added; });
      if (typeof window.hiRefreshCart === 'function') {
        window.hiRefreshCart();
      }
      setTimeout(function() {
        btns.forEach(function(b) {
          b.disabled = false;
          b.textContent = window.hiI18n.add_to_cart;
        });
      }, 2200);
    })
    .catch(function() {
      btns.forEach(function(b) { b.disabled = false; b.textContent = window.hiI18n.add_to_cart; });
    });
  }

  window.hiAddToCart = function(sectionId) { doAddToCart(sectionId); };
  window.hiStickyAddToCart = function(sectionId) { doAddToCart(sectionId); };

  // Initialize all PDP sections
  document.querySelectorAll('[data-hi-pdp-section]').forEach(function(el) {
    initPdp(el.dataset.hiPdpSection);
  });

  // Initialize thumbnail carousel button states
  document.querySelectorAll('[id^="hi-tcarousel-"]').forEach(function(carousel) {
    var sectionId = carousel.id.replace('hi-tcarousel-', '');
    var thumbs = document.getElementById('hi-thumbs-' + sectionId);
    if (!thumbs) return;
    var total = thumbs.querySelectorAll('.hi-thumb').length;
    var btnDown = document.getElementById('hi-tcbtn-down-' + sectionId);
    if (btnDown && total <= HI_VISIBLE) btnDown.disabled = true;

    // Mobile: track scroll position to update button states
    var viewport = carousel.querySelector('.hi-thumbs-viewport');
    if (viewport) {
      viewport.addEventListener('scroll', function() {
        var btnUp = document.getElementById('hi-tcbtn-up-' + sectionId);
        var btnDn = document.getElementById('hi-tcbtn-down-' + sectionId);
        var atStart = viewport.scrollLeft <= 1;
        var atEnd = viewport.scrollLeft >= viewport.scrollWidth - viewport.clientWidth - 1;
        if (btnUp) btnUp.disabled = atStart;
        if (btnDn) btnDn.disabled = atEnd;
      });
    }
  });
})();
{% endjavascript %}

