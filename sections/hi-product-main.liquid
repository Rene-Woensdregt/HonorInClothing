  font-weight: 600;
  color: #16150F;
}

/* Sticky add bar */
.hi-stickybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(251,249,245,.97);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1px solid #E7E2D7;
  box-shadow: 0 -10px 34px rgba(20,21,15,.09);
  transform: translateY(110%);
  transition: transform .34s cubic-bezier(.2,.7,.3,1);
}
.hi-stickybar--show { transform: none; }
.hi-stickybar-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 32px;
  display: flex;
  align-items: center;
  gap: 18px;
}
.hi-stickybar-thumb {
  width: 52px;
  height: 64px;
  background-size: cover;
  background-position: center;
  background-color: #E9E4DA;
  flex-shrink: 0;
}
.hi-stickybar-info { min-width: 0; flex: 1; }
.hi-stickybar-name {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 15px;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #16150F;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hi-stickybar-variant { font-size: 13px; color: #8A8479; margin-top: 2px; }
.hi-stickybar-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; flex-shrink: 0; }
.hi-sticky-qty { height: 50px; }
.hi-sticky-qty button { width: 44px; }
.hi-stickybar-addbtn { min-width: 160px; }

/* Responsive */
@media (max-width: 900px) {
  .hi-pdp-grid { grid-template-columns: minmax(0, 1fr); gap: 34px; }
  .hi-buybox { position: static; }
}
@media (max-width: 640px) {
  .hi-pdp-breadcrumb-wrap { padding: 16px 20px 0; }
  .hi-pdp-main { padding: 20px 20px 50px; }
  .hi-gallery { display: flex; flex-direction: column; align-items: stretch; gap: 10px; min-width: 0; max-width: 100%; overflow: hidden; }
  .hi-gallery-main { order: 1; width: 100%; min-width: 0; max-width: 100%; }
  .hi-tcarousel { order: 2; flex-direction: row; align-items: center; gap: 4px; min-width: 0; max-width: 100%; overflow: hidden; }
  .hi-tcarousel-btn { width: 26px; height: 48px; flex-shrink: 0; }
  .hi-tcarousel-btn--up svg { transform: rotate(-90deg); }
  .hi-tcarousel-btn--down svg { transform: rotate(-90deg); }
  .hi-thumbs-viewport { height: 48px; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; flex: 1; min-width: 0; align-items: center; }
  .hi-thumbs-viewport::-webkit-scrollbar { display: none; }
  .hi-thumbs { flex-direction: row !important; gap: 8px; transform: none !important; transition: none !important; }
  .hi-thumb { width: 48px; height: 48px; aspect-ratio: unset; flex-shrink: 0; }
  .hi-buyrow { flex-wrap: wrap; }
  .hi-buyrow .hi-qty { order: 1; }
  .hi-buyrow .hi-addbtn { order: 2; flex: 1 1 100% !important; }
  .hi-stickybar-inner { padding: 10px 20px; gap: 14px; }
  .hi-sticky-qty { display: none !important; }
  .hi-stickybar-addbtn { padding: 13px 16px !important; font-size: 12px !important; letter-spacing: .08em !important; }
}

/* drawer close button reuse */
.hi-drawer-close {
  background: none;
  border: none;
  cursor: pointer;
  color: #16150F;
  padding: 4px;
  line-height: 0;
}
.hi-drawer-close svg { width: 22px; height: 22px; }
