{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign color_option_index = nil
  assign size_option_index = nil
  for option in product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name == 'color' or opt_name == 'colour'
      assign color_option_index = forloop.index0
    endif
    if opt_name == 'size'
      assign size_option_index = forloop.index0
    endif
  endfor
  assign current_collection = collection
  if current_collection == blank
    assign current_collection = product.collections.first
  endif
  assign badge = nil
  for tag in product.tags
    if tag == 'New' or tag == 'Best Seller' or tag == 'Sale'
      assign badge = tag
      break
    endif
  endfor
  assign first_image = product.featured_image
-%}

<script>
window.hiI18n = window.hiI18n || {
  add_to_cart: {{ 'hi.pdp.add_to_cart' | t | json }},
  sold_out: {{ 'hi.pdp.sold_out' | t | json }},
  adding: {{ 'hi.pdp.adding' | t | json }},
  added: {{ 'hi.pdp.added' | t | json }}
};
</script>

<script type="application/json" id="hi-pdp-json-{{ section.id }}">
{
  "variants": [
    {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "price_formatted": {{ variant.price | money | json }},
      "compare_at_price_formatted": {{ variant.compare_at_price | money | default: null | json }},
      "compare_at_price": {{ variant.compare_at_price | default: 0 }},
      "price": {{ variant.price }},
      "option1": {{ variant.option1 | json }},
      "option2": {{ variant.option2 | json }},
      "option3": {{ variant.option3 | json }},
      "featured_media_id": {{ variant.featured_media.id | default: 'null' }},
      "title": {{ variant.title | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

<div class="hi-pdp-section" data-hi-pdp-section="{{ section.id }}">

  <!-- Breadcrumb -->
  {%- if section.settings.show_breadcrumb -%}
  <div class="hi-x hi-pdp-breadcrumb-wrap">
    <nav class="hi-breadcrumb" aria-label="{{ 'hi.pdp.breadcrumb' | t }}">
      <a href="/" class="hi-breadcrumb-link">{{ 'hi.pdp.home' | t }}</a>
      <span>/</span>
      {%- if current_collection != blank -%}
        <a href="{{ current_collection.url }}" class="hi-breadcrumb-link">{{ current_collection.title }}</a>
        <span>/</span>
      {%- endif -%}
      <span class="hi-breadcrumb-current">{{ product.title }}</span>
    </nav>
  </div>
  {%- endif -%}

  <!-- Product main -->
  <section class="hi-x hi-pdp-main">
    <div class="hi-pdp-grid">

      <!-- Gallery -->
      <div class="hi-gallery" id="hi-gallery-{{ section.id }}">
        <div class="hi-tcarousel" id="hi-tcarousel-{{ section.id }}">
          <button class="hi-tcarousel-btn hi-tcarousel-btn--up"
                  id="hi-tcbtn-up-{{ section.id }}"
                  onclick="hiThumbNav('{{ section.id }}', -1)"
                  aria-label="Previous images"
                  disabled>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 9.5L7 4.5L12 9.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="hi-thumbs-viewport">
            <div class="hi-thumbs" id="hi-thumbs-{{ section.id }}">
              {%- if product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <div class="hi-thumb{% if forloop.first %} hi-thumb--active{% endif %}"
                       data-media-id="{{ media.id }}"
                       onclick="hiPdpSelectMedia('{{ section.id }}', {{ media.id }})"
                       aria-label="{{ media.alt | default: product.title | escape }}">
                    <div class="img" style="background-image:url('{{ media | image_url: width: 200 }}');"></div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="hi-thumb hi-thumb--active">
                  <div class="img" style="background:#E9E4DA;"></div>
                </div>
              {%- endif -%}
            </div>
          </div>
          <button class="hi-tcarousel-btn hi-tcarousel-btn--down"
                  id="hi-tcbtn-down-{{ section.id }}"
                  onclick="hiThumbNav('{{ section.id }}', 1)"
                  aria-label="Next images">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 4.5L7 9.5L12 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="hi-gallery-main" id="hi-gallery-main-{{ section.id }}">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="hi-gallery-slide{% if forloop.first %} hi-gallery-slide--active{% endif %}"
                   data-media-id="{{ media.id }}">
                <div class="img" style="background-image:url('{{ media | image_url: width: 900 }}');"></div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="hi-gallery-slide hi-gallery-slide--active">
              <div class="img" style="background:#E9E4DA;"></div>
            </div>
          {%- endif -%}
          {%- if badge != blank -%}
            <span class="hi-badge">{{ badge }}</span>
          {%- endif -%}
        </div>
      </div>

      <!-- Buy box -->
      <div class="hi-buybox" id="hi-buybox-{{ section.id }}">

        {%- if product.type != blank -%}
          <div class="hi-buybox-cat">{{ product.type }}</div>
        {%- endif -%}
        <h1 class="hi-buybox-title">{{ product.title }}</h1>

        <!-- Price -->
        <div class="hi-buybox-price" id="hi-price-{{ section.id }}">
          <span class="hi-price-main">{{ selected_variant.price | money }}</span>
          {%- if selected_variant.compare_at_price > selected_variant.price -%}
            <span class="hi-price-compare">{{ selected_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Blurb -->
        {%- if product.description != blank -%}
          <p class="hi-buybox-blurb">{{ product.description | strip_html }}</p>
        {%- endif -%}

        {%- assign pdp_form_id = 'hi-pdp-form-' | append: section.id -%}
        {%- form 'product', product, id: pdp_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" id="hi-variant-id-{{ section.id }}" value="{{ selected_variant.id }}">
          <input type="hidden" name="quantity" id="hi-qty-input-{{ section.id }}" value="1">

          <!-- Color option -->
          {%- if color_option_index != nil -%}
            {%- assign color_option = product.options_with_values[color_option_index] -%}
            <div class="hi-option-group">
              <div class="hi-option-label">
                {{ 'hi.pdp.color' | t }} — <span id="hi-color-name-{{ section.id }}">{{ selected_variant.options[color_option_index] }}</span>
              </div>
              <div class="hi-colors">
                {%- for value in color_option.values -%}
                  {%- assign swatch_key = value | downcase | replace: ' / ', '-' | replace: '/', '-' | replace: ' ', '-' -%}
                  <div class="hi-color{% if selected_variant.options[color_option_index] == value %} hi-color--active{% endif %}"
                       data-section-id="{{ section.id }}"
                       data-option-index="{{ color_option_index }}"
                       data-value="{{ value | escape }}"
                       title="{{ value | escape }}"
                       onclick="hiPdpSelectOption('{{ section.id }}', {{ color_option_index }}, this.dataset.value)">
                    <span class="dot" style="background:var(--hi-swatch-{{ swatch_key }}, #C4B9A8);"></span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Size option -->
          {%- if size_option_index != nil -%}
            {%- assign size_option = product.options_with_values[size_option_index] -%}
            <div class="hi-option-group">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <span class="hi-option-label" style="margin-bottom:0;">{{ 'hi.pdp.size' | t }}</span>
                <button type="button" onclick="hiToggleSizeGuide('{{ section.id }}')" class="hi-sizeguide-btn" aria-label="{{ 'hi.pdp.size_guide' | t }}">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="10" rx="1"></rect><line x1="8" y1="7" x2="8" y2="12"></line><line x1="12" y1="7" x2="12" y2="14"></line><line x1="16" y1="7" x2="16" y2="12"></line></svg>
                  {{ 'hi.pdp.size_guide' | t }}
                </button>
              </div>
              <div class="hi-sizes">
                {%- for value in size_option.values -%}
                  {%- assign size_available = false -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.options[size_option_index] == value and variant.available -%}
                      {%- assign size_available = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button type="button"
                          class="hi-size{% if selected_variant.options[size_option_index] == value %} hi-size--active{% endif %}{% unless size_available %} hi-size--soldout{% endunless %}"
                          data-section-id="{{ section.id }}"
                          data-option-index="{{ size_option_index }}"
                          data-value="{{ value | escape }}"
                          {% unless size_available %}disabled{% endunless %}
                          onclick="hiPdpSelectOption('{{ section.id }}', {{ size_option_index }}, this.dataset.value)">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
              <div id="hi-size-error-{{ section.id }}" class="hi-size-error" style="display:none;">
                {{ 'hi.pdp.select_size' | t }}
              </div>
            </div>
          {%- endif -%}

          <!-- Qty + ATC -->
          <div class="hi-buyrow" id="hi-buyrow-{{ section.id }}">
            <div class="hi-qty" id="hi-qty-{{ section.id }}">
              <button type="button" onclick="hiPdpDecQty('{{ section.id }}')" aria-label="{{ 'hi.pdp.decrease_qty' | t }}">−</button>
              <span id="hi-qty-display-{{ section.id }}">1</span>
              <button type="button" onclick="hiPdpIncQty('{{ section.id }}')" aria-label="{{ 'hi.pdp.increase_qty' | t }}">+</button>
            </div>
            <button type="submit"
                    id="hi-atc-btn-{{ section.id }}"
                    class="hi-btn hi-btn--primary hi-addbtn"
                    {%- unless selected_variant.available -%}disabled{%- endunless -%}>
              {%- if selected_variant.available -%}
                {{ 'hi.pdp.add_to_cart' | t }}
              {%- else -%}
                {{ 'hi.pdp.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        <!-- Trust signals -->
        <div class="hi-trust-box">
          <div class="hi-trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="15" height="12" rx="1"></rect><path d="M16 9h4l3 3v6h-7z"></path><circle cx="6" cy="19" r="2"></circle><circle cx="19" cy="19" r="2"></circle></svg>
            <div>
              <div class="hi-trust-title">{{ 'hi.pdp.trust_ship_title' | t }}</div>
              <div class="hi-trust-desc">{{ 'hi.pdp.trust_ship_desc' | t }}</div>
            </div>
          </div>
          <div class="hi-trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><polyline points="3 3 3 8 8 8"></polyline></svg>
            <div>
              <div class="hi-trust-title">{{ 'hi.pdp.trust_return_title' | t }}</div>
              <div class="hi-trust-desc">{{ 'hi.pdp.trust_return_desc' | t }}</div>
            </div>
          </div>
          <div class="hi-trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6 6 .5-4.5 4 1.5 6.5L12 16l-6 3 1.5-6.5L3 8.5 9 8z"></path></svg>
            <div>
              <div class="hi-trust-title">{{ 'hi.pdp.trust_give_title' | t }}</div>
              <div class="hi-trust-desc">{{ 'hi.pdp.trust_give_desc' | t }}</div>
            </div>
          </div>
        </div>

        <!-- Accordions -->
        <div class="hi-accs">
          {%- if product.description != blank -%}
            <div class="hi-acc">
              <button type="button" class="hi-acc-btn" data-open="false" onclick="hiToggleAcc(this)">
                {{ 'hi.pdp.description' | t }} <span class="hi-acc-icon">+</span>
              </button>
              <div class="hi-acc-panel" data-open="false">
                <div class="hi-acc-content hi-rte">{{ product.description }}</div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.materials_content != blank -%}
            <div class="hi-acc">
              <button type="button" class="hi-acc-btn" data-open="false" onclick="hiToggleAcc(this)">
                {{ 'hi.pdp.materials' | t }} <span class="hi-acc-icon">+</span>
              </button>
              <div class="hi-acc-panel" data-open="false">
                <div class="hi-acc-content">{{ section.settings.materials_content }}</div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.shipping_content != blank -%}
            <div class="hi-acc">
              <button type="button" class="hi-acc-btn" data-open="false" onclick="hiToggleAcc(this)">
                {{ 'hi.pdp.shipping' | t }} <span class="hi-acc-icon">+</span>
              </button>
              <div class="hi-acc-panel" data-open="false">
                <div class="hi-acc-content">{{ section.settings.shipping_content }}</div>
              </div>
            </div>
          {%- endif -%}
        </div>

      </div><!-- /hi-buybox -->
    </div><!-- /hi-pdp-grid -->
  </section>

</div><!-- /hi-pdp-section -->

<!-- Size Guide Modal -->
<div id="hi-size-guide-{{ section.id }}"
     class="hi-size-guide-overlay"
     style="display:none;"
     onclick="hiToggleSizeGuide('{{ section.id }}')">
  <div class="hi-size-guide-modal" onclick="event.stopPropagation()">
    <div class="hi-size-guide-head">
      <div class="hi-size-guide-title">{{ 'hi.pdp.size_guide' | t }}</div>
      <button type="button" class="hi-drawer-close" onclick="hiToggleSizeGuide('{{ section.id }}')" aria-label="{{ 'hi.pdp.close' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
    </div>
    <div class="hi-size-guide-body">
      {%- if section.settings.size_guide_content != blank -%}
        {{ section.settings.size_guide_content }}
      {%- else -%}
        <p style="font-size:14.5px;line-height:1.6;color:#54504A;margin:0 0 20px;">{{ 'hi.pdp.size_guide_note' | t }}</p>
        <div class="hi-size-table">
          <div class="hi-size-table-head">
            <div>{{ 'hi.pdp.size_col_size' | t }}</div>
            <div>{{ 'hi.pdp.size_col_chest' | t }}</div>
            <div>{{ 'hi.pdp.size_col_waist' | t }}</div>
            <div>{{ 'hi.pdp.size_col_length' | t }}</div>
          </div>
          <div class="hi-size-table-row"><div>XS</div><div>32–34"</div><div>26–28"</div><div>27"</div></div>
          <div class="hi-size-table-row"><div>S</div><div>35–37"</div><div>29–31"</div><div>28"</div></div>
          <div class="hi-size-table-row"><div>M</div><div>38–40"</div><div>32–34"</div><div>29"</div></div>
          <div class="hi-size-table-row"><div>L</div><div>41–43"</div><div>35–37"</div><div>30"</div></div>
          <div class="hi-size-table-row"><div>XL</div><div>44–46"</div><div>38–40"</div><div>31"</div></div>
          <div class="hi-size-table-row"><div>XXL</div><div>47–49"</div><div>41–43"</div><div>32"</div></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Sticky Add Bar -->
<div class="hi-stickybar" id="hi-stickybar-{{ section.id }}" aria-hidden="true">
  <div class="hi-stickybar-inner">
    {%- if first_image -%}
      <div class="hi-stickybar-thumb" style="background-image:url('{{ first_image | image_url: width: 200 }}');"></div>
    {%- endif -%}
    <div class="hi-stickybar-info">
      <div class="hi-stickybar-name">{{ product.title }}</div>
      {%- unless selected_variant.title == 'Default Title' -%}
      <div class="hi-stickybar-variant" id="hi-sticky-variant-{{ section.id }}">{{ selected_variant.title }}</div>
      {%- else -%}
      <div class="hi-stickybar-variant" id="hi-sticky-variant-{{ section.id }}" style="display:none;"></div>
      {%- endunless -%}
    </div>
    <div class="hi-stickybar-actions">
      <div class="hi-qty hi-sticky-qty" id="hi-sticky-qty-{{ section.id }}">
        <button type="button" onclick="hiPdpDecQty('{{ section.id }}')" aria-label="{{ 'hi.pdp.decrease_qty' | t }}">−</button>
        <span id="hi-sticky-qty-display-{{ section.id }}">1</span>
        <button type="button" onclick="hiPdpIncQty('{{ section.id }}')" aria-label="{{ 'hi.pdp.increase_qty' | t }}">+</button>
      </div>
      <button type="button"
              id="hi-sticky-atc-{{ section.id }}"
              class="hi-btn hi-btn--primary hi-stickybar-addbtn"
              onclick="hiStickyAddToCart('{{ section.id }}')"
              {%- unless selected_variant.available -%}disabled{%- endunless -%}>
        {%- if selected_variant.available -%}
          {{ 'hi.pdp.add_to_cart' | t }}
        {%- else -%}
          {{ 'hi.pdp.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>
  </div>
</div>

{% stylesheet %}
