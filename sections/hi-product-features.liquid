<section class="hi-feat-section">
  <div class="hi-feat-inner hi-x">
    {%- for block in section.blocks -%}
      <div class="hi-feat-item" {{ block.shopify_attributes }}>
        {%- if block.settings.label != blank -%}
          <div class="hi-feat-label">{{ block.settings.label }}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <div class="hi-feat-title">{{ block.settings.title }}</div>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <div class="hi-feat-desc">{{ block.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="hi-feat-item">
          <div class="hi-feat-label">{{ 'hi.pdp.features.placeholder_label' | t }}</div>
          <div class="hi-feat-title">{{ 'hi.pdp.features.placeholder_title' | t }}</div>
          <div class="hi-feat-desc">{{ 'hi.pdp.features.placeholder_desc' | t }}</div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.hi-feat-section {
  background: #16150F;
  color: #F3EFE6;
}
.hi-feat-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 64px 32px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.hi-feat-label {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: #9AA585;
  margin-bottom: 12px;
}
.hi-feat-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 20px;
  text-transform: uppercase;
  letter-spacing: .02em;
  margin-bottom: 10px;
  color: #F3EFE6;
}
.hi-feat-desc {
  font-size: 14.5px;
  line-height: 1.7;
  color: #B6B1A4;
}
@media (max-width: 640px) {
  .hi-feat-inner { grid-template-columns: 1fr; gap: 34px; padding: 48px 20px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_product_features.name",
  "blocks": [
    {
      "type": "feature",
      "name": "t:hi.hi_product_features.blocks.feature.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:hi.hi_product_features.blocks.feature.settings.label.label",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:hi.hi_product_features.blocks.feature.settings.title.label",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:hi.hi_product_features.blocks.feature.settings.description.label",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_product_features.name",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "label": "Performance",
            "title": "Built to Move",
            "description": "Engineered with 4-way stretch fabric and articulated patterning so you move without restriction — on the trail or off it."
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "Durability",
            "title": "Made to Last",
            "description": "Reinforced stress points, YKK zippers, and Cordura panels where it counts. Built for the long haul, not a single season."
          }
        },
        {
          "type": "feature",
          "settings": {
            "label": "Protection",
            "title": "Weather Ready",
            "description": "DWR-treated shell repels light rain and wind. When the weather turns, you're already covered."
          }
        }
      ]
    }
  ]
}
{% endschema %}
