<section class="hi-highlights-section">
  <div class="hi-x hi-highlights-inner">
    <div class="hi-highlight-grid">
      <!-- Image -->
      <div class="hi-highlight-img-wrap">
        {%- if section.settings.image != blank -%}
          <div class="hi-highlight-img" style="background-image:url('{{ section.settings.image | image_url: width: 900 }}');"></div>
        {%- else -%}
          <div class="hi-highlight-img" style="background:#E9E4DA;"></div>
        {%- endif -%}
      </div>

      <!-- Content -->
      <div class="hi-highlight-content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="hi-highlight-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hi-highlight-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="hi-highlight-list">
          {%- for block in section.blocks -%}
            <div class="hi-highlight-item" {{ block.shopify_attributes }}>
              <div class="hi-highlight-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
              <div>
                {%- if block.settings.title != blank -%}
                  <div class="hi-highlight-item-title">{{ block.settings.title }}</div>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="hi-highlight-item-desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.hi-highlights-section {
  background: #FBF9F5;
  padding: 0;
}
.hi-highlights-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 84px 32px 40px;
}
.hi-highlight-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.hi-highlight-img-wrap {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #E9E4DA;
}
.hi-highlight-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform .6s cubic-bezier(.2,.7,.3,1);
}
.hi-highlight-img-wrap:hover .hi-highlight-img { transform: scale(1.04); }
.hi-highlight-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 14px;
}
.hi-highlight-heading {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  font-size: clamp(26px, 3.2vw, 40px);
  line-height: 1.05;
  margin: 0 0 28px;
  color: #16150F;
}
.hi-highlight-list { display: flex; flex-direction: column; }
.hi-highlight-item {
  display: flex;
  gap: 18px;
  padding: 20px 0;
  border-top: 1px solid #E7E2D7;
}
.hi-highlight-item:last-child { border-bottom: 1px solid #E7E2D7; }
.hi-highlight-num {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border: 1px solid #D7D0C2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 14px;
  color: #5C6B47;
}
.hi-highlight-item-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 15px;
  letter-spacing: .06em;
  text-transform: uppercase;
  margin-bottom: 6px;
  color: #16150F;
}
.hi-highlight-item-desc {
  font-size: 14.5px;
  line-height: 1.65;
  color: #54504A;
}
@media (max-width: 900px) {
  .hi-highlight-grid { grid-template-columns: 1fr; gap: 32px; }
  .hi-highlights-inner { padding: 60px 32px 40px; }
}
@media (max-width: 640px) {
  .hi-highlights-inner { padding: 60px 20px 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:hi.hi_product_highlights.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:hi.hi_product_highlights.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hi.hi_product_highlights.settings.eyebrow.label",
      "default": "The Details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:hi.hi_product_highlights.settings.heading.label",
      "default": "Built into every stitch."
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "t:hi.hi_product_highlights.blocks.highlight.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:hi.hi_product_highlights.blocks.highlight.settings.title.label",
          "default": "Feature Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:hi.hi_product_highlights.blocks.highlight.settings.description.label",
          "default": "Feature description explaining the benefit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:hi.hi_product_highlights.name",
      "blocks": [
        { "type": "highlight", "settings": { "title": "4-Way Stretch Fabric", "description": "Our proprietary blend moves with you in every direction — no binding, no pulling, no excuses." } },
        { "type": "highlight", "settings": { "title": "Reinforced Stress Points", "description": "Triple-stitched seams and bartacks at every stress point mean this piece outlasts the season." } },
        { "type": "highlight", "settings": { "title": "DWR Weather Repellent", "description": "Durable Water Repellent finish sheds light rain and holds off wind chill on the fly." } },
        { "type": "highlight", "settings": { "title": "YKK Hardware", "description": "Every zipper, buckle, and snap is YKK — because the details matter on the trail and off it." } }
      ]
    }
  ]
}
{% endschema %}
