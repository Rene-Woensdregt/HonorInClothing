{% doc %}
  Hi Header — sticky nav with 3-level mega menus and mobile drawer accordion.

  Main navigation: section.settings.menu (link_list) drives all top-level nav links.

  Mega menus: add a "Mega menu" block per nav item that needs one.
    - nav_title must match the nav link's exact title (e.g. "Men").
    - mega_linklist is a separate Shopify navigation menu where:
        • Top-level links  = column headers (level 2)
        • Their children   = links inside each column (level 3)
    - Optionally add a featured image card shown on the right side of the panel.
{% enddoc %}

<header class="hi-header" data-hi-header>
  <div class="hi-header-inner">

    {%- comment -%}──── LEFT: burger + desktop nav ────{%- endcomment -%}
    <div class="hi-header-left">

      <button type="button" class="hi-burger" data-hi-burger
        aria-label="{{ 'hi.general.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="hi-drawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <nav class="hi-desktop-nav" aria-label="{{ 'hi.general.main_nav' | t }}">
        {%- assign nav_links = linklists[section.settings.menu].links -%}
        {%- for link in nav_links -%}

          {%- comment -%}
            Find a mega_menu block whose nav_title matches this link's title.
            The block's existence enables the mega panel; its sub-links come
            from link.links (children of this item in the main menu).
          {%- endcomment -%}
          {%- assign mega_block = nil -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.nav_title == link.title -%}
              {%- assign mega_block = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign mega_list = nil -%}
          {%- if mega_block != nil and mega_block.settings.mega_linklist != blank -%}
            {%- assign mega_list = linklists[mega_block.settings.mega_linklist] -%}
          {%- endif -%}
          {%- assign has_mega = false -%}
          {%- if mega_list != nil and mega_list.links.size > 0 -%}
            {%- assign has_mega = true -%}
          {%- endif -%}

          <div class="hi-navitem">
            <a href="{{ link.url }}"
              class="hi-navlink"
              {%- if link.active %} aria-current="page"{%- endif -%}>
              {{ link.title }}
            </a>

            {%- if has_mega -%}
              <div class="hi-megapanel" role="region" aria-label="{{ link.title }}" {{ mega_block.shopify_attributes }}>
                <div class="hi-megapanel-inner">

                  {%- comment -%}
                    Level 2 = column headers (top-level links in mega_linklist)
                    Level 3 = items within each column (their children)
                  {%- endcomment -%}
                  <div class="hi-megacols">
                    {%- for col in mega_list.links -%}
                      <div class="hi-megacol">
                        <div class="hi-megacol-title">{{ col.title }}</div>
                        {%- for item in col.links -%}
                          <a href="{{ item.url }}" class="hi-megalink">{{ item.title }}</a>
                        {%- endfor -%}
                      </div>
                    {%- endfor -%}
                  </div>

                  {%- comment -%} Optional featured image card {%- endcomment -%}
                  {%- assign feat_img   = mega_block.settings.mega_image -%}
                  {%- assign feat_title = mega_block.settings.mega_title -%}
                  {%- assign feat_cta   = mega_block.settings.mega_cta_text -%}
                  {%- assign feat_url   = mega_block.settings.mega_cta_url | default: link.url -%}
                  {%- if feat_img != blank or feat_title != blank -%}
                    <a href="{{ feat_url }}" class="hi-megafeat">
                      <div class="hi-megafeat-img">
                        {%- if feat_img != blank -%}
                          {{ feat_img | image_url: width: 700 | image_tag:
                              loading: 'lazy',
                              alt: feat_title,
                              class: 'hi-megafeat-photo' }}
                        {%- endif -%}
                      </div>
                      <div class="hi-megafeat-grad"></div>
                      <div class="hi-megafeat-content">
                        <div class="hi-megafeat-label">{{ link.title }}</div>
                        {%- if feat_title != blank -%}
                          <div class="hi-megafeat-title">{{ feat_title }}</div>
                        {%- endif -%}
                        <div class="hi-megafeat-cta">{{ feat_cta | default: 'Shop Now' }} →</div>
                      </div>
                    </a>
                  {%- endif -%}

                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>
    </div>

    {%- comment -%}──── CENTER: logo ────{%- endcomment -%}
    <a href="{{ routes.root_url }}" class="hi-logo-link" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 200 | image_tag:
            class: 'hi-logo-img', loading: 'eager', alt: shop.name }}
      {%- else -%}
        <div class="hi-logo-text">
          <span class="hi-logo-l1">{{ section.settings.logo_text_line1 | default: 'HONOR IN' }}</span>
          <span class="hi-logo-l2">{{ section.settings.logo_text_line2 | default: 'CLOTHING CO.' }}</span>
        </div>
      {%- endif -%}
    </a>

    {%- comment -%}──── RIGHT: search, account, cart ────{%- endcomment -%}
    <div class="hi-header-right">
      <a href="{{ routes.search_url }}" class="hi-navlink hi-desktop-only">{{ 'hi.general.search' | t }}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="hi-navlink hi-desktop-only">{{ 'hi.general.account' | t }}</a>
      {%- endif -%}
      <button type="button" class="hi-cart-trigger" data-hi-cart-trigger
        aria-label="{{ 'hi.general.cart' | t }}">
        {{ 'hi.general.cart' | t }}
        <span class="hi-cart-badge" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>

  </div>
</header>

{%- comment -%}──── MOBILE DRAWER ────{%- endcomment -%}
<div class="hi-drawer-backdrop" data-hi-drawer-backdrop></div>
<aside class="hi-drawer" id="hi-drawer" data-hi-drawer
  role="dialog" aria-modal="true" aria-label="{{ 'hi.general.menu' | t }}">

  <div class="hi-drawer-head">
    <div class="hi-logo-text">
      <span class="hi-logo-l1" style="font-size:18px;letter-spacing:.16em;">
        {{ section.settings.logo_text_line1 | default: 'HONOR IN' }}
      </span>
    </div>
    <button type="button" class="hi-drawer-close" data-hi-drawer-close
      aria-label="{{ 'hi.general.close_menu' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <a href="{{ routes.search_url }}" class="hi-drawer-row">{{ 'hi.general.search' | t }}</a>

  {%- for link in linklists[section.settings.menu].links -%}
    {%- comment -%} Find matching mega block for this nav link {%- endcomment -%}
    {%- assign drawer_block = nil -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.nav_title == link.title -%}
        {%- assign drawer_block = block -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- assign drawer_list = nil -%}
    {%- if drawer_block != nil and drawer_block.settings.mega_linklist != blank -%}
      {%- assign drawer_list = linklists[drawer_block.settings.mega_linklist] -%}
    {%- endif -%}

    {%- if drawer_list != nil and drawer_list.links.size > 0 -%}
      <button type="button" class="hi-drawer-row" data-hi-acc aria-expanded="false">
        {{ link.title }} <span class="hi-acc-plus" aria-hidden="true">+</span>
      </button>
      <div class="hi-acc-panel" role="region">
        {%- for col in drawer_list.links -%}
          <div class="hi-acc-coltitle">{{ col.title }}</div>
          {%- for item in col.links -%}
            <a href="{{ item.url }}" class="hi-acc-link">{{ item.title }}</a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <a href="{{ link.url }}" class="hi-drawer-row">{{ link.title }}</a>
    {%- endif -%}
  {%- endfor -%}

  {%- if shop.customer_accounts_enabled -%}
    <a href="{{ routes.account_url }}" class="hi-drawer-row">{{ 'hi.general.account' | t }}</a>
  {%- endif -%}
  <button type="button" class="hi-drawer-row" data-hi-cart-trigger>
    {{ 'hi.general.cart' | t }} ({{ cart.item_count }})
  </button>

</aside>

{% stylesheet %}
/* ─────────── Header shell ─────────── */
.hi-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(251,249,245,.96);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid #E7E2D7;
  transition: transform .35s cubic-bezier(.2,.7,.3,1);
  will-change: transform;
}
.hi-header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 32px;
  height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

/* ─────────── Left ─────────── */
.hi-header-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
}

/* ─────────── Burger — hidden on desktop, shown on mobile ─────────── */
.hi-burger {
  display: none !important;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  margin-left: -6px;
  color: #16150F;
  align-items: center;
}
.hi-burger svg { width: 24px; height: 24px; display: block; }

/* ─────────── Desktop nav ─────────── */
.hi-desktop-nav {
  display: flex;
  align-items: center;
  gap: 26px;
}
.hi-navitem {
  display: flex;
  align-items: center;
  height: 74px;
}

/* ─────────── Nav link + animated underline ─────────── */
.hi-navlink {
  position: relative;
  color: #3A372F;
  font-family: 'Oswald', sans-serif;
  font-weight: 500;
  font-size: 13px;
  letter-spacing: .13em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color .2s cubic-bezier(.2,.7,.3,1);
}
.hi-navlink::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  bottom: -4px;
  height: 2px;
  background: var(--hi-accent, #5C6B47);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .26s cubic-bezier(.2,.7,.3,1);
}
.hi-navitem:hover > .hi-navlink,
.hi-navlink:hover { color: #16150F; }
.hi-navitem:hover > .hi-navlink::after,
.hi-navlink:hover::after { transform: scaleX(1); }

/* ─────────── Mega panel ─────────── */
.hi-megapanel {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100vw;
  background: #FBF9F5;
  border-top: 1px solid #E7E2D7;
  box-shadow: 0 30px 46px rgba(20,21,15,.13);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  pointer-events: none;
  transition: opacity .26s cubic-bezier(.2,.7,.3,1),
              transform .26s cubic-bezier(.2,.7,.3,1),
              visibility .26s;
  z-index: 45;
}
.hi-navitem:hover .hi-megapanel {
  opacity: 1;
  visibility: visible;
  transform: none;
  pointer-events: auto;
}
.hi-megapanel-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 42px 32px 46px;
  display: flex;
  gap: 56px;
  align-items: flex-start;
}
.hi-megacols {
  display: flex;
  gap: 40px;
  flex: 1;
  flex-wrap: wrap;
  align-items: flex-start;
}
.hi-megacol { min-width: 100px; }
/* Level 2: column header */
.hi-megacol-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: #16150F;
  margin-bottom: 14px;
}
/* Level 3: items within each column */
.hi-megalink {
  display: block;
  color: #54504A;
  text-decoration: none;
  font-size: 14.5px;
  padding: 7px 0;
  width: max-content;
  transition: color .2s ease, transform .2s ease;
}
.hi-megalink:hover { color: #16150F; transform: translateX(5px); }

/* ─────────── Mega featured image (right panel) ─────────── */
.hi-megafeat {
  position: relative;
  display: block;
  width: 300px;
  flex-shrink: 0;
  aspect-ratio: 5 / 4;
  overflow: hidden;
  text-decoration: none;
  background: #E9E4DA;
  transition: box-shadow .4s cubic-bezier(.2,.7,.3,1);
}
.hi-megafeat:hover { box-shadow: 0 18px 38px rgba(20,21,15,.2); }
.hi-megafeat-img { position: absolute; inset: 0; overflow: hidden; }
.hi-megafeat-photo {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform .9s cubic-bezier(.2,.7,.3,1);
}
.hi-megafeat:hover .hi-megafeat-photo { transform: scale(1.07); }
.hi-megafeat-grad {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(12,12,9,0) 28%, rgba(12,12,9,.74) 100%);
}
.hi-megafeat-content {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 22px 24px; color: #fff;
}
.hi-megafeat-label {
  font-family: 'Oswald', sans-serif;
  font-weight: 500; font-size: 11px;
  letter-spacing: .2em; text-transform: uppercase;
  color: #E2DCCE; margin-bottom: 6px;
}
.hi-megafeat-title {
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 20px;
  text-transform: uppercase; letter-spacing: .02em; line-height: 1.05;
}
.hi-megafeat-cta {
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 12px;
  letter-spacing: .14em; text-transform: uppercase;
  margin-top: 12px;
  border-bottom: 2px solid var(--hi-accent, #5C6B47);
  padding-bottom: 3px;
  display: inline-block;
}

/* ─────────── Logo ─────────── */
.hi-logo-link {
  text-decoration: none;
  text-align: center;
  flex-shrink: 0;
  transition: opacity .2s ease;
}
.hi-logo-link:hover { opacity: .7; }
.hi-logo-img { height: 40px; width: auto; display: block; }
.hi-logo-text { display: flex; flex-direction: column; align-items: center; }
.hi-logo-l1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700; font-size: 23px;
  letter-spacing: .18em; color: #16150F; line-height: 1;
}
.hi-logo-l2 {
  font-family: 'Oswald', sans-serif;
  font-weight: 400; font-size: 9.5px;
  letter-spacing: .42em; color: var(--hi-accent, #5C6B47); margin-top: 3px;
}

/* ─────────── Right ─────────── */
.hi-header-right {
  display: flex;
  align-items: center;
  gap: 22px;
  flex: 1;
  justify-content: flex-end;
}
.hi-cart-trigger {
  display: flex;
  align-items: center;
  gap: 7px;
  background: none; border: none; padding: 0;
  cursor: pointer;
  color: #16150F;
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 13px;
  letter-spacing: .13em; text-transform: uppercase;
  transition: opacity .2s ease;
}
.hi-cart-trigger:hover { opacity: .6; }
.hi-cart-badge {
  background: var(--hi-accent, #5C6B47);
  color: #fff;
  border-radius: 50%;
  min-width: 18px; height: 18px;
  padding: 0 5px;
  display: inline-flex; align-items: center; justify-content: center;
  font-family: 'Oswald', sans-serif;
  font-size: 11px; font-weight: 600; line-height: 1;
}

/* ─────────── Mobile drawer ─────────── */
.hi-drawer-backdrop {
  position: fixed; inset: 0;
  background: rgba(12,12,9,.5);
  opacity: 0; visibility: hidden;
  transition: opacity .3s ease, visibility .3s;
  z-index: 199;
}
.hi-drawer-backdrop[data-open="true"] { opacity: 1; visibility: visible; }
.hi-drawer {
  position: fixed; top: 0; left: 0; bottom: 0;
  width: 86%; max-width: 360px;
  background: #FBF9F5;
  z-index: 200;
  transform: translateX(-100%);
  transition: transform .34s cubic-bezier(.2,.7,.3,1);
  overflow-y: auto; -webkit-overflow-scrolling: touch;
}
.hi-drawer[data-open="true"] {
  transform: none;
  box-shadow: 0 0 60px rgba(12,12,9,.34);
}
.hi-drawer-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 22px;
  border-bottom: 1px solid #E7E2D7;
  position: sticky; top: 0; background: #FBF9F5;
}
.hi-drawer-close {
  background: none; border: none;
  cursor: pointer; color: #16150F;
  padding: 4px; line-height: 0;
}
.hi-drawer-close svg { width: 22px; height: 22px; }
.hi-drawer-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; width: 100%;
  padding: 16px 22px;
  border: none; border-bottom: 1px solid #ECE7DC;
  background: none; cursor: pointer;
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 16px;
  letter-spacing: .08em; text-transform: uppercase;
  color: #16150F; text-decoration: none; text-align: left;
  box-sizing: border-box;
}
.hi-acc-plus {
  font-size: 22px; font-weight: 300; line-height: 1;
  transition: transform .3s ease;
  color: var(--hi-accent, #5C6B47);
}
.hi-drawer-row[data-open="true"] .hi-acc-plus { transform: rotate(45deg); }
.hi-acc-panel {
  max-height: 0; overflow: hidden;
  transition: max-height .34s cubic-bezier(.2,.7,.3,1);
  background: #F1ECE1;
}
.hi-acc-panel[data-open="true"] { max-height: 1200px; }
.hi-acc-coltitle {
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 11px;
  letter-spacing: .18em; text-transform: uppercase;
  color: #8A8479; padding: 16px 26px 6px;
}
.hi-acc-link {
  display: block; padding: 9px 26px;
  color: #54504A; text-decoration: none;
  font-family: 'Oswald', sans-serif;
  font-weight: 500; font-size: 14px;
  letter-spacing: .06em; text-transform: uppercase;
  transition: color .2s ease;
}
.hi-acc-link:hover { color: #16150F; }

/* ─────────── Responsive ─────────── */
@media (max-width: 900px) {
  .hi-desktop-nav { display: none !important; }
  .hi-desktop-only { display: none !important; }
  .hi-burger { display: inline-flex !important; }
  .hi-header-inner { padding: 0 20px; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  var burger   = document.querySelector('[data-hi-burger]');
  var backdrop = document.querySelector('[data-hi-drawer-backdrop]');
  var drawer   = document.querySelector('[data-hi-drawer]');
  var closeBtn = document.querySelector('[data-hi-drawer-close]');

  function openDrawer() {
    if (!drawer) return;
    drawer.setAttribute('data-open', 'true');
    if (backdrop) backdrop.setAttribute('data-open', 'true');
    if (burger) burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.removeAttribute('data-open');
    if (backdrop) backdrop.removeAttribute('data-open');
    if (burger) burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (burger)   burger.addEventListener('click', openDrawer);
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (drawer) {
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeDrawer);
    });
  }

  /* Accordion */
  document.querySelectorAll('[data-hi-acc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var isOpen = btn.getAttribute('data-open') === 'true';
      var panel  = btn.nextElementSibling;
      btn.setAttribute('data-open',     isOpen ? 'false' : 'true');
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel) panel.setAttribute('data-open', isOpen ? 'false' : 'true');
    });
  });

  /* Scroll hide / show */
  var header = document.querySelector('[data-hi-header]');
  if (header) {
    var lastY = 0, ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () {
          var y = window.scrollY || 0;
          header.style.transform = (y > lastY && y > 140)
            ? 'translateY(-100%)'
            : 'translateY(0)';
          lastY = y;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "nav_title",
          "label": "Navigation item name",
          "info": "Must match the exact nav link title (e.g. \"Men\"). This ties the block to that nav item."
        },
        {
          "type": "link_list",
          "id": "mega_linklist",
          "label": "Mega menu links",
          "info": "Create a navigation menu where top-level links are column headers (level 2) and their children are the links inside each column (level 3)."
        },
        {
          "type": "header",
          "content": "Featured image card"
        },
        {
          "type": "image_picker",
          "id": "mega_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "mega_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "mega_cta_text",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "mega_cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main navigation menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
