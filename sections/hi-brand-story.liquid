<section class="hi-about">
  <div class="hi-about-grid">
    <div class="hi-about-text" data-hi-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hi-about-eyebrow">
          <span class="hi-about-eyebrow-line" aria-hidden="true"></span>
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hi-about-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_1 != blank -%}
        <div class="hi-about-body">{{ section.settings.body_1 }}</div>
      {%- endif -%}
      {%- if section.settings.body_2 != blank -%}
        <div class="hi-about-body">{{ section.settings.body_2 }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="hi-btn hi-btn--ink hi-about-cta">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="hi-about-img">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: class: 'hi-about-img-el', loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="hi-about-img-placeholder"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.hi-about { background: #F1ECE1; overflow: hidden; }
.hi-about-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: #5C6B47;
  margin-bottom: 18px;
}
.hi-about-eyebrow-line {
  display: inline-block;
  width: 34px;
  height: 1px;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-about-heading {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(28px, 3vw, 42px);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
  line-height: 1.05;
  color: #16150F;
  margin: 0 0 22px !important;
}
.hi-about-body {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.75;
  color: #54504A;
  margin-bottom: 18px;
}
.hi-about-cta { margin-top: 0; }
.hi-about-img-el {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hi-about-img-placeholder {
  position: absolute;
  inset: 0;
  background: #C5BFB5;
}
@media (max-width: 900px) {
  .hi-about-grid { grid-template-columns: 1fr; }
  .hi-about-text { padding: 56px 24px 48px; min-height: 0; }
  .hi-about-img { position: static; width: 100%; height: 380px; }
  .hi-about-img-el { position: static; width: 100%; height: 380px; object-fit: cover; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "e.g. The Honor In Story",
      "default": "The Honor In Story",
      "info": "Small uppercase label shown above the heading with a sage green accent line"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "placeholder": "e.g. More than apparel — a way of living.",
      "default": "More than apparel — a way of living."
    },
    {
      "type": "richtext",
      "id": "body_1",
      "label": "First paragraph",
      "default": "<p>Honor In Clothing was founded on a simple belief: the clothes you wear should reflect the values you live by. Built for those who chase purpose over comfort.</p>"
    },
    {
      "type": "richtext",
      "id": "body_2",
      "label": "Second paragraph",
      "info": "Leave blank to show only one paragraph",
      "default": "<p>Every piece we make is designed for movement, built for endurance, and worn with intention. This is apparel for people who show up — every single day.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "placeholder": "e.g. Read Our Story",
      "default": "Our Full Story",
      "info": "Leave blank to hide the button"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right side image",
      "info": "Fills the full right half of the section. Portrait or square images work best."
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
