<section class="hi-hero">
  {%- if section.settings.image != blank -%}
    <div class="hi-hero-bg" aria-hidden="true">
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'hi-hero-bg-img', loading: 'eager', alt: section.settings.heading, fetchpriority: 'high' }}
    </div>
  {%- else -%}
    <div class="hi-hero-bg hi-hero-bg--placeholder" aria-hidden="true"></div>
  {%- endif -%}
  <div class="hi-hero-overlay" aria-hidden="true"></div>
  <div class="hi-hero-content" data-hi-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <div class="hi-hero-eyebrow">
        <span class="hi-hero-eyebrow-line" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hi-hero-heading">{{ section.settings.heading | newline_to_br }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hi-hero-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hi-hero-btns">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="hi-btn hi-btn--light">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url }}" class="hi-btn hi-btn--ghost">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.hi-hero {
  position: relative;
  height: 90vh;
  min-height: 600px;
  max-height: 880px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}
.hi-hero-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.hi-hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  animation: hi-kenburns 14s ease-out both;
}
.hi-hero-bg--placeholder {
  background: #2a2a22;
}
.hi-hero-overlay {
  display: block !important;
  position: absolute;
  inset: 0;
  background: linear-gradient(
    177deg,
    rgba(12,12,9,.30) 0%,
    rgba(12,12,9,.12) 38%,
    rgba(12,12,9,.82) 100%
  );
  pointer-events: none;
}
.hi-hero-content {
  position: relative;
  z-index: 2;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 0 32px 78px;
  color: #fff;
  text-shadow: 0 2px 22px rgba(10,11,8,.42);
}
.hi-hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: 'Oswald', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: #E9E3D4;
  margin-bottom: 22px;
}
.hi-hero-eyebrow-line {
  display: inline-block;
  width: 34px;
  height: 1px;
  background: #5C6B47;
  flex-shrink: 0;
}
.hi-hero-heading {
  font-family: 'Oswald', sans-serif;
  font-weight: 700;
  font-size: clamp(42px, 6.6vw, 88px);
  letter-spacing: .005em;
  text-transform: uppercase;
  line-height: .96;
  margin: 0;
  max-width: 15ch;
  text-wrap: balance;
  color: #fff;
}
.hi-hero .hi-hero-sub {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.65;
  color: rgba(247,243,234,.88);
  max-width: 50ch;
  margin: 24px 0 34px;
}
.hi-hero-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}
@media (max-width: 900px) {
  .hi-hero {
    height: 82vh;
    min-height: 540px;
  }
  .hi-hero-content {
    padding: 0 24px 52px;
  }
  .hi-hero-eyebrow {
    font-size: 11px;
    letter-spacing: .12em;
    margin-bottom: 14px;
    gap: 10px;
  }
  .hi-hero-heading {
    font-size: clamp(34px, 9vw, 46px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Premium Active Lifestyle Apparel"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Live With Honor."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Built for those who show up."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
